---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { path } from '../utils/paths';
import AhkhStorage from '../components/AhkhStorage.astro';
import AhkhSyncBridge from '../components/AhkhSyncBridge.astro';

interface Props {
  title: string;
  description?: string;
  readerLib?: boolean;
}

const {
  title,
  description = "A sovereign, local-first library and companion for deep course study, reading, and highlighting.",
  readerLib = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={path('/logo.png')} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={path('/logo-white.png')} media="(prefers-color-scheme: dark)" />

    <!-- Google Fonts Preconnect & Stylesheet for Instant Bulletproof Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,500;0,7..72,600;1,7..72,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap" /> <!-- impeccable-disable-line overused-font -- reader selectable fonts -->

    <ClientRouter fallback="animate" />

    <AhkhStorage />
    <AhkhSyncBridge />

    <!-- Shared reader library (ADR-027): loaded once per session on reader pages, booted per lesson -->
    {readerLib && <script is:inline src={path('/scripts/reader.js')}></script>}

    <!-- Anti-FOUC & Global Theme/Font Initialization -->
    <script is:inline>
      (function() {
        function getSavedTheme() {
          try {
            return window.AhkhStorage.get('ahkh_theme') || 'system';
          } catch (e) {
            return 'system';
          }
        }

        function resolveEffectiveDark(theme) {
          if (theme === 'dark') return true;
          if (theme === 'light') return false;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function applyTheme(theme) {
          const isDark = resolveEffectiveDark(theme);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          document.documentElement.setAttribute('data-theme-setting', theme);
        }

        function applyGlobalFont() {
          try {
            const fontMap = {
              'merriweather': "'Merriweather', Georgia, serif",
              'source-serif': "'Source Serif 4', Georgia, serif",
              'literata': "'Literata', Georgia, serif",
              'lora': "'Lora', Georgia, serif",
              'newsreader': "'Newsreader', Georgia, serif",
              'geist': "'Geist', -apple-system, BlinkMacSystemFont, sans-serif",
              'inter': "'Geist', -apple-system, BlinkMacSystemFont, sans-serif",
              'serif': "'Merriweather', Georgia, serif",
              'sans': "'Geist', -apple-system, BlinkMacSystemFont, sans-serif"
            };

            let savedFont = window.AhkhStorage.get('ahkh_reader_font_family');
            if (!savedFont || savedFont === 'serif' || !fontMap[savedFont]) {
              savedFont = 'merriweather';
              window.AhkhStorage.set('ahkh_reader_font_family', 'merriweather');
            }

            const val = fontMap[savedFont] || fontMap['merriweather'];
            document.documentElement.style.setProperty('--reader-font-family', val);
          } catch (e) {}
        }

        const initialTheme = getSavedTheme();
        applyTheme(initialTheme);
        applyGlobalFont();

        function syncThemeButtons(currentTheme) {
          var theme = currentTheme || getSavedTheme();
          var buttons = document.querySelectorAll('.theme-btn');
          for (var i = 0; i < buttons.length; i++) {
            var val = buttons[i].getAttribute('data-theme-value');
            buttons[i].setAttribute('aria-pressed', val === theme ? 'true' : 'false');
          }
        }

        window.__getTheme = getSavedTheme;
        window.__applyTheme = applyTheme;
        window.__applyGlobalFont = applyGlobalFont;
        window.__syncThemeButtons = syncThemeButtons;

        syncThemeButtons(initialTheme);

        window.__setTheme = function(theme) {
          try {
            window.AhkhStorage.set('ahkh_theme', theme);
          } catch (e) {}
          applyTheme(theme);
          syncThemeButtons(theme);
          window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: theme } }));
        };

        // Delegated click handler: guarantees every .theme-btn works anywhere, anytime
        document.addEventListener('click', function(e) {
          var btn = e.target && e.target.closest ? e.target.closest('.theme-btn') : null;
          if (!btn) return;
          var val = btn.getAttribute('data-theme-value');
          if (val && window.__setTheme) {
            window.__setTheme(val);
          }
        });

        document.addEventListener('astro:page-load', function() {
          syncThemeButtons();
        });

        if (window.matchMedia) {
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          const handleChange = function() {
            if (getSavedTheme() === 'system') {
              applyTheme('system');
              window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: 'system' } }));
            }
          };
          if (mediaQuery.addEventListener) {
            mediaQuery.addEventListener('change', handleChange);
          } else if (mediaQuery.addListener) {
            mediaQuery.addListener(handleChange);
          }
        }

        window.addEventListener('storage', function(e) {
          if (e.key === 'ahkh_theme') {
            const next = e.newValue || 'system';
            applyTheme(next);
            window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: next } }));
          }
        });

        /* View Transitions: seamlessly preserve theme state to eliminate any light/dark flash during page swaps */
        document.addEventListener('astro:before-swap', function(e) {
          const currentTheme = getSavedTheme();
          const isDark = resolveEffectiveDark(currentTheme);
          if (isDark) {
            e.newDocument.documentElement.classList.add('dark');
          } else {
            e.newDocument.documentElement.classList.remove('dark');
          }
          e.newDocument.documentElement.setAttribute('data-theme-setting', currentTheme);

          /* Synchronize badge state so the incoming header snapshot matches the current header perfectly */
          const currentBadge = document.getElementById('global-highlight-badge');
          const newBadge = e.newDocument.getElementById('global-highlight-badge');
          if (currentBadge && newBadge) {
            if (!currentBadge.classList.contains('hidden')) {
              newBadge.textContent = currentBadge.textContent;
              newBadge.classList.remove('hidden');
            } else {
              newBadge.classList.add('hidden');
            }
          }
        });

        document.addEventListener('astro:after-swap', function() {
          applyTheme(getSavedTheme());
          applyGlobalFont();
        });

        /* Global Route Navigation Progress Bar */
        var routeProgressTimer = null;
        document.addEventListener('astro:before-preparation', function() {
          var bar = document.getElementById('route-loading-bar');
          if (!bar) return;
          clearTimeout(routeProgressTimer);
          bar.classList.remove('is-loaded');
          bar.classList.add('is-loading');
          bar.style.width = '35%';
          routeProgressTimer = setTimeout(function() {
            bar.style.width = '75%';
          }, 150);
        });

        document.addEventListener('astro:page-load', function() {
          var bar = document.getElementById('route-loading-bar');
          if (bar) {
            clearTimeout(routeProgressTimer);
            if (bar.classList.contains('is-loading')) {
              bar.style.width = '100%';
              bar.classList.add('is-loaded');
              routeProgressTimer = setTimeout(function() {
                bar.classList.remove('is-loading', 'is-loaded');
                bar.style.width = '0%';
              }, 350);
            }
          }

          /* Progressive image loading enhancement */
          var imgs = document.querySelectorAll('img:not(.ahkh-img-loaded)');
          for (var i = 0; i < imgs.length; i++) {
            var img = imgs[i];
            if (img.complete) {
              img.classList.add('ahkh-img-loaded');
              img.classList.remove('ahkh-img-loading');
            } else {
              img.classList.add('ahkh-img-loading');
              img.addEventListener('load', function() {
                this.classList.add('ahkh-img-loaded');
                this.classList.remove('ahkh-img-loading');
              }, { once: true });
            }
          }
        });
      })();
    </script>
  </head>
  <body class="bg-white dark:bg-dark-bg text-ink dark:text-dark-ink min-h-screen flex flex-col selection:bg-paper-200 dark:selection:bg-dark-border selection:text-ink dark:selection:text-dark-ink transition-colors duration-150">
    <div id="route-loading-bar" aria-hidden="true"></div>
    <slot />
  </body>
</html>
