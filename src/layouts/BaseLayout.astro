---
import '../styles/global.css';

import { path } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "A sovereign, local-first library and companion for deep course study, reading, and highlighting." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={path('/logo.png')} />
  </head>
  <body class="bg-paper-50 text-ink min-h-screen flex flex-col selection:bg-paper-200 selection:text-ink transition-colors duration-150">
    <slot />
  </body>
</html>
