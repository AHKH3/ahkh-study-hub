---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { path } from '../utils/paths';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "A sovereign, local-first library and companion for deep course study, reading, and highlighting." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={path('/logo.png')} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={path('/logo-white.png')} media="(prefers-color-scheme: dark)" />

    <ClientRouter fallback="animate" />

    <!-- Anti-FOUC & Global Theme Initialization -->
    <script is:inline>
      (function() {
        function getSavedTheme() {
          try {
            return localStorage.getItem('ahkh_theme') || 'system';
          } catch (e) {
            return 'system';
          }
        }

        function resolveEffectiveDark(theme) {
          if (theme === 'dark') return true;
          if (theme === 'light') return false;
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        }

        function applyTheme(theme) {
          const isDark = resolveEffectiveDark(theme);
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          document.documentElement.setAttribute('data-theme-setting', theme);
        }

        const initialTheme = getSavedTheme();
        applyTheme(initialTheme);

        window.__getTheme = getSavedTheme;
        window.__applyTheme = applyTheme;
        window.__setTheme = function(theme) {
          try {
            localStorage.setItem('ahkh_theme', theme);
          } catch (e) {}
          applyTheme(theme);
          window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: theme } }));
        };

        if (window.matchMedia) {
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          const handleChange = function() {
            if (getSavedTheme() === 'system') {
              applyTheme('system');
              window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: 'system' } }));
            }
          };
          if (mediaQuery.addEventListener) {
            mediaQuery.addEventListener('change', handleChange);
          } else if (mediaQuery.addListener) {
            mediaQuery.addListener(handleChange);
          }
        }

        window.addEventListener('storage', function(e) {
          if (e.key === 'ahkh_theme') {
            const next = e.newValue || 'system';
            applyTheme(next);
            window.dispatchEvent(new CustomEvent('ahkh-theme-change', { detail: { theme: next } }));
          }
        });

        // View Transitions: seamlessly preserve theme state to eliminate any light/dark flash during page swaps
        document.addEventListener('astro:before-swap', function(e) {
          const currentTheme = getSavedTheme();
          const isDark = resolveEffectiveDark(currentTheme);
          if (isDark) {
            e.newDocument.documentElement.classList.add('dark');
          } else {
            e.newDocument.documentElement.classList.remove('dark');
          }
          e.newDocument.documentElement.setAttribute('data-theme-setting', currentTheme);

          // Synchronize badge state so the incoming header snapshot matches the current header perfectly
          const currentBadge = document.getElementById('global-highlight-badge');
          const newBadge = e.newDocument.getElementById('global-highlight-badge');
          if (currentBadge && newBadge) {
            if (!currentBadge.classList.contains('hidden')) {
              newBadge.textContent = currentBadge.textContent;
              newBadge.classList.remove('hidden');
            } else {
              newBadge.classList.add('hidden');
            }
          }
        });

        document.addEventListener('astro:after-swap', function() {
          applyTheme(getSavedTheme());
        });
      })();
    </script>
  </head>
  <body class="bg-paper-50 dark:bg-dark-bg text-ink dark:text-dark-ink min-h-screen flex flex-col selection:bg-paper-200 dark:selection:bg-dark-border selection:text-ink dark:selection:text-dark-ink transition-colors duration-150">
    <slot />

    <!-- Digital Scribe Title Entrance (Hybrid Model) -->
    <script>
      function playEditorialTypewriter() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const h1 = document.querySelector('main h1');
        if (!h1 || h1.dataset.typed === 'true') return;

        const originalText = h1.textContent?.trim();
        if (!originalText || originalText.length < 2) return;

        h1.dataset.typed = 'true';
        h1.innerHTML = '';
        const charSpans: HTMLSpanElement[] = [];

        for (let i = 0; i < originalText.length; i++) {
          const span = document.createElement('span');
          span.textContent = originalText[i];
          span.style.opacity = '0';
          span.style.filter = 'blur(1.5px)';
          span.style.transition = 'opacity 35ms ease-out, filter 35ms ease-out';
          h1.appendChild(span);
          charSpans.push(span);
        }

        const cursor = document.createElement('span');
        cursor.className = 'editorial-cursor';
        cursor.textContent = '|';
        cursor.setAttribute('aria-hidden', 'true');
        h1.appendChild(cursor);

        let idx = 0;
        const delay = Math.max(8, Math.min(18, Math.floor(240 / originalText.length)));

        function step() {
          if (idx < charSpans.length) {
            charSpans[idx].style.opacity = '1';
            charSpans[idx].style.filter = 'blur(0)';
            if (charSpans[idx].nextSibling !== cursor) {
              h1?.insertBefore(cursor, charSpans[idx].nextSibling);
            }
            idx++;
            setTimeout(step, delay);
          } else {
            setTimeout(() => {
              cursor.classList.add('fade-out');
              setTimeout(() => {
                cursor.remove();
                if (h1) {
                  h1.textContent = originalText;
                  delete h1.dataset.typed;
                }
              }, 300);
            }, 200);
          }
        }

        step();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', playEditorialTypewriter);
      } else {
        playEditorialTypewriter();
      }
      document.addEventListener('astro:page-load', playEditorialTypewriter);
    </script>
  </body>
</html>
