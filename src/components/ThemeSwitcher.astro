---
interface Props {
  class?: string;
  size?: 'sm' | 'md';
}

const { 
  class: className = '', 
  size = 'sm',
} = Astro.props;
---

<div class:list={["theme-dropdown-wrapper relative inline-block text-left", className]}>
  <!-- Dropdown Trigger Button -->
  <button
    type="button"
    class:list={[
      "theme-dropdown-btn rounded-xs border border-ink-border/70 dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink transition-colors cursor-pointer flex items-center justify-center shadow-2xs focus:outline-hidden",
      size === 'sm' ? "w-8 h-8 p-1.5" : "w-9 h-9 p-2"
    ]}
    aria-label="Toggle theme menu"
    aria-haspopup="true"
    aria-expanded="false"
    title="Theme settings"
  >
    <!-- Sun icon (Light) -->
    <svg class="theme-icon-light w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
    </svg>
    <!-- Laptop/Monitor icon (System) -->
    <svg class="theme-icon-system w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="20" height="14" x="2" y="3" rx="2"/>
      <line x1="8" x2="16" y1="21" y2="21"/>
      <line x1="12" x2="12" y1="17" y2="21"/>
    </svg>
    <!-- Moon icon (Dark) -->
    <svg class="theme-icon-dark w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
    </svg>
  </button>

  <!-- Dropdown Popover Menu -->
  <div 
    class="theme-dropdown-menu hidden absolute right-0 mt-1.5 w-32 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-card shadow-lg z-50 py-1 text-xs font-ui transition-all"
    role="menu"
    aria-orientation="vertical"
  >
    <!-- Light Option -->
    <button
      type="button"
      data-theme-value="light"
      role="menuitem"
      class="theme-btn w-full px-3 py-2 text-left flex items-center justify-between gap-2 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <span>Light</span>
      </div>
      <svg class="theme-check-icon w-3.5 h-3.5 hidden text-ink dark:text-dark-ink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>

    <!-- System Option -->
    <button
      type="button"
      data-theme-value="system"
      role="menuitem"
      class="theme-btn w-full px-3 py-2 text-left flex items-center justify-between gap-2 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="14" x="2" y="3" rx="2"/>
          <line x1="8" x2="16" y1="21" y2="21"/>
          <line x1="12" x2="12" y1="17" y2="21"/>
        </svg>
        <span>System</span>
      </div>
      <svg class="theme-check-icon w-3.5 h-3.5 hidden text-ink dark:text-dark-ink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>

    <!-- Dark Option -->
    <button
      type="button"
      data-theme-value="dark"
      role="menuitem"
      class="theme-btn w-full px-3 py-2 text-left flex items-center justify-between gap-2 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer"
    >
      <div class="flex items-center gap-2">
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <span>Dark</span>
      </div>
      <svg class="theme-check-icon w-3.5 h-3.5 hidden text-ink dark:text-dark-ink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>
  </div>
</div>

<script>
  function closeAllThemeMenus() {
    document.querySelectorAll('.theme-dropdown-menu').forEach((menu) => {
      menu.classList.add('hidden');
    });
    document.querySelectorAll('.theme-dropdown-btn').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
  }

  function initThemeDropdowns() {
    document.querySelectorAll('.theme-dropdown-wrapper').forEach((wrapper) => {
      const btn = wrapper.querySelector<HTMLButtonElement>('.theme-dropdown-btn');
      const menu = wrapper.querySelector<HTMLDivElement>('.theme-dropdown-menu');
      if (!btn || !menu) return;

      btn.onclick = (e) => {
        e.stopPropagation();
        const isHidden = menu.classList.contains('hidden');
        closeAllThemeMenus();
        if (isHidden) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
        }
      };

      menu.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((item) => {
        item.onclick = (e) => {
          e.stopPropagation();
          const target = item.getAttribute('data-theme-value');
          if (target && (window as any).__setTheme) {
            (window as any).__setTheme(target);
          }
          closeAllThemeMenus();
        };
      });
    });
  }

  if (!(window as any).__ahkhThemeDropdownWired) {
    (window as any).__ahkhThemeDropdownWired = true;
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement)?.closest('.theme-dropdown-wrapper')) {
        closeAllThemeMenus();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeAllThemeMenus();
      }
    });
  }

  // Run immediately if DOM ready
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initThemeDropdowns();
  }

  // Single boot path: ClientRouter fires astro:page-load on initial load and navigation
  document.addEventListener('astro:page-load', initThemeDropdowns);
</script>


