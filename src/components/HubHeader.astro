---
import { path } from '../utils/paths';
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
  activeTab?: 'library' | 'manifesto' | 'commonplace' | 'downloads';
}

const { activeTab = 'library' } = Astro.props;
---

<header 
  transition:name="hub-header"
  class="hub-header w-full border-b border-ink-border/60 dark:border-dark-border bg-paper-100/90 dark:bg-dark-bg/90 backdrop-blur-sm sticky top-0 z-30 transition-colors"
>
  <div class="max-w-hub mx-auto px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href={path('/')} class="group flex items-center gap-2.5 py-1">
      <img 
        src={path('/logo.png')} 
        alt="AHKH" 
        class="h-6 sm:h-7 w-auto object-contain shrink-0 dark:hidden" 
      />
      <img 
        src={path('/logo-white.png')} 
        alt="AHKH" 
        class="h-6 sm:h-7 w-auto object-contain shrink-0 hidden dark:block" 
      />
      <span class="font-ui text-lg sm:text-xl font-medium tracking-tight text-ink dark:text-dark-ink">study hub</span>
    </a>

    <!-- Navigation Links & Theme Controls -->
    <div class="flex items-center gap-2 sm:gap-3">
      <nav class="flex flex-wrap items-center gap-1 sm:gap-2 text-sm font-ui">
        <a 
          href={path('/')} 
          class:list={[
            "px-3 py-1.5 rounded-sm transition-colors border",
            activeTab === 'library' 
              ? "text-ink dark:text-dark-ink font-medium bg-paper-200/80 dark:bg-dark-card border-ink-border/60 dark:border-dark-border" 
              : "border-transparent text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/50 dark:hover:bg-dark-card/50"
          ]}
        >
          Library
        </a>
        <a 
          href={path('/manifesto')} 
          class:list={[
            "nav-manifesto px-3 py-1.5 rounded-sm transition-colors border",
            activeTab === 'manifesto' 
              ? "text-ink dark:text-dark-ink font-medium bg-paper-200/80 dark:bg-dark-card border-ink-border/60 dark:border-dark-border" 
              : "border-transparent text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/50 dark:hover:bg-dark-card/50"
          ]}
        >
          Manifesto
        </a>
        <a 
          href={path('/commonplace')} 
          class:list={[
            "px-3 py-1.5 rounded-sm transition-colors border flex items-center gap-1.5",
            activeTab === 'commonplace' 
              ? "text-ink dark:text-dark-ink font-medium bg-paper-200/80 dark:bg-dark-card border-ink-border/60 dark:border-dark-border" 
              : "border-transparent text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/50 dark:hover:bg-dark-card/50"
          ]}
        >
          Commonplace
          <span id="global-highlight-badge" class="hidden font-mono text-[11px] px-1.5 py-0.5 rounded-full bg-ink/10 dark:bg-dark-border text-ink dark:text-dark-ink">
            0
          </span>
        </a>
        <a 
          href={path('/downloads')} 
          class:list={[
            "nav-downloads px-3 py-1.5 rounded-sm transition-colors border",
            activeTab === 'downloads' 
              ? "text-ink dark:text-dark-ink font-medium bg-paper-200/80 dark:bg-dark-card border-ink-border/60 dark:border-dark-border" 
              : "border-transparent text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/50 dark:hover:bg-dark-card/50"
          ]}
        >
          Downloads
        </a>
      </nav>

      <button
        type="button"
        id="update-check-btn"
        title="Check for application updates"
        class="items-center gap-1.5 px-3 py-1.5 rounded-sm border border-ink-border/60 dark:border-dark-border bg-paper-200/50 dark:bg-dark-card/50 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/80 dark:hover:bg-dark-card transition-colors text-sm font-ui cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12a9 9 0 1 1-2.64-6.36M21 3v6h-6"/>
        </svg>
        <span id="update-check-label">Update</span>
      </button>

      <div class="h-4 w-px bg-ink-border/60 dark:bg-dark-border" aria-hidden="true"></div>

      <ThemeSwitcher />
    </div>
  </div>
</header>

<script is:inline>
  // Calculate total highlights count for the commonplace badge
  window.updateGlobalBadge = function() {
    let total = 0;
    const store = window.AhkhStorage;
    if (!store) return;
    const keys = store.scan('ahkh_hl_');
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i];
      if (key !== 'ahkh_hl_color') {
        try {
          const items = JSON.parse(store.get(key) || '[]');
          if (Array.isArray(items)) {
            total += items.length;
          }
        } catch (e) {}
      }
    }
    const badge = document.getElementById('global-highlight-badge');
    if (badge) {
      if (total > 0) {
        badge.textContent = total;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  };
  // Single boot path (ClientRouter always enabled): run now for the parsed
  // header, re-run on every navigation without stacking listeners.
  window.updateGlobalBadge();
  if (!window.__ahkhBadgeBoot) {
    window.__ahkhBadgeBoot = true;
    document.addEventListener('astro:page-load', window.updateGlobalBadge);
  }

  // Desktop-only update check (ADR-022): the Downloads page stays on the web,
  // while the installed app verifies and installs releases in place.
  (function initUpdateCheck() {
    var btn = document.getElementById('update-check-btn');
    var label = document.getElementById('update-check-label');
    var api = window.__TAURI__ && window.__TAURI__.core ? window.__TAURI__.core : null;
    if (!btn || !api) return;
    if (btn.dataset.ahkhWired) return;
    btn.dataset.ahkhWired = 'true';
    var busy = false;
    function setLabel(text) {
      if (label) label.textContent = text;
    }
    btn.addEventListener('click', function () {
      if (busy) return;
      busy = true;
      setLabel('Checking');
      try {
        api.invoke('plugin:updater|check', { target: null }).then(function (update) {
          busy = false;
          if (update && update.version) {
            setLabel('Updating');
          } else {
            setLabel('Up to date');
            setTimeout(function () { setLabel('Update'); }, 3000);
          }
        }).catch(function () {
          busy = false;
          setLabel('Unavailable');
          setTimeout(function () { setLabel('Update'); }, 3000);
        });
      } catch (e) {
        busy = false;
        setLabel('Update');
      }
    });
  })();
</script>
