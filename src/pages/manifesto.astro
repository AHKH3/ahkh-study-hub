---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/HubHeader.astro';
import { path } from '../utils/paths';
---

<BaseLayout 
  title="Manifesto — AHKH Study Hub" 
  description="The architecture of literature: Transforming raw, monotonous text into enduring knowledge through HTML and CSS."
>
  <HubHeader activeTab="manifesto" />

  <main class="flex-1 max-w-reading w-full mx-auto px-6 py-12 sm:py-16">
    <!-- Header: Aligned precisely with the reading measure -->
    <header class="mb-12 pb-8 border-b border-ink-border dark:border-dark-border">
      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-ink dark:text-dark-ink leading-[1.15] mb-4">
        The Architecture of Literature
      </h1>
      <p class="font-serif italic text-lg sm:text-xl text-ink dark:text-dark-ink leading-relaxed">
        Transforming raw, monotonous text into enduring knowledge through the spatial cadence of HTML and CSS.
      </p>
    </header>

    <!-- Manifesto Body -->
    <article id="manifesto-content" class="prose-editorial space-y-14">
      
      <!-- Section I -->
      <section>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-dark-ink tracking-tight mb-4">
          I. The Crisis of Monotonous Text
        </h2>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed mb-4">
          Knowledge in the digital age is trapped between two hostile extremes. On one side lies the noisy, commercial web—choked by algorithmic feeds, tracking pixels, cookie banners, and aggressive popups designed to fragment human attention. On the other side lies raw, monotonous text: uniform grey paragraphs, dry video transcripts dumped into flat files, rigid scanned PDFs, and academic documentation where every heading looks identical.
        </p>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed">
          When text is presented without architectural intention, the mind tires before deep comprehension can even take root. Reading complex systems architecture, cognitive science, or product philosophy should never feel like wading through an undifferentiated database export. Text demands spatial cadence, visual hierarchy, and structural relief.
        </p>
      </section>

      <!-- Seminal Pullout Quote (Axiom 01) -->
      <aside class="my-12 pl-6 sm:pl-8 border-l-2 border-ink dark:border-dark-ink bg-paper-100/60 dark:bg-dark-card/40 py-4 transition-colors">
        <blockquote class="font-serif text-xl sm:text-2xl italic text-ink dark:text-dark-ink leading-snug">
          “The medium through which thought is recorded is never inert. Typography, margins, and spatial organization either invite sustained contemplation or enforce mental fatigue.”
        </blockquote>
        <cite class="block font-mono text-xs text-ink/80 dark:text-dark-ink/80 not-italic mt-4 tracking-wider uppercase font-semibold">
          — The Sanctuary Canon, Axiom 01
        </cite>
      </aside>

      <!-- Section II -->
      <section>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-dark-ink tracking-tight mb-4">
          II. Re-Architecting with the Power of HTML & CSS
        </h2>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed mb-6">
          Our core mission is neither to rewrite original thinkers nor to summarize them away. Our mission is to take raw, unshaped source material and reconstruct its physical vessel. We harness the semantic expressiveness and aesthetic flexibility of modern HTML and CSS to forge literature out of prose:
        </p>

        <!-- Sequential Canonical Matrix -->
        <div class="not-prose my-10 border-t border-b border-ink-border dark:border-dark-border divide-y divide-ink-border/60 dark:divide-dark-border/60">
          
          <div class="py-5 sm:py-6 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="font-mono text-xs uppercase tracking-widest text-ink dark:text-dark-ink shrink-0 w-8 font-bold">
              01
            </div>
            <div class="space-y-1.5 flex-1">
              <h3 class="font-serif text-lg font-bold text-ink dark:text-dark-ink">
                Tactile Containers & Partitions
              </h3>
              <p class="font-serif text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">
                Discrete mental units, prerequisite tracks, and module milestones are encapsulated into tactile containers that provide definitive spatial boundaries for the mind.
              </p>
            </div>
          </div>

          <div class="py-5 sm:py-6 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="font-mono text-xs uppercase tracking-widest text-ink dark:text-dark-ink shrink-0 w-8 font-bold">
              02
            </div>
            <div class="space-y-1.5 flex-1">
              <h3 class="font-serif text-lg font-bold text-ink dark:text-dark-ink">
                Commanding Pullouts & Proclamations
              </h3>
              <p class="font-serif text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">
                Seminal principles and foundational aphorisms break free of the body measure, anchored with deliberate weight to serve as conceptual resting posts for contemplation.
              </p>
            </div>
          </div>

          <div class="py-5 sm:py-6 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="font-mono text-xs uppercase tracking-widest text-ink dark:text-dark-ink shrink-0 w-8 font-bold">
              03
            </div>
            <div class="space-y-1.5 flex-1">
              <h3 class="font-serif text-lg font-bold text-ink dark:text-dark-ink">
                Dignified Callouts & Ethical Guardrails
              </h3>
              <p class="font-serif text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">
                Crucial caveats, contextual footnotes, and ethical guardrails are set apart with dignified framing, illuminating nuances without derailing the primary narrative flow.
              </p>
            </div>
          </div>

          <div class="py-5 sm:py-6 flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
            <div class="font-mono text-xs uppercase tracking-widest text-ink dark:text-dark-ink shrink-0 w-8 font-bold">
              04
            </div>
            <div class="space-y-1.5 flex-1">
              <h3 class="font-serif text-lg font-bold text-ink dark:text-dark-ink">
                Responsive Data Matrices
              </h3>
              <p class="font-serif text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">
                Dense comparative matrices trapped in static PDFs are liberated into responsive, legible compositions where relationships between variables are immediate, fluid, and clear.
              </p>
            </div>
          </div>

        </div>
      </section>

      <!-- Exemplary Dignified Callout -->
      <div class="not-prose my-10 p-6 sm:p-7 rounded-xs border border-ink-border dark:border-dark-border bg-paper-100/70 dark:bg-dark-card transition-colors">
        <div class="flex items-start gap-4">
          <div class="p-2 rounded-xs bg-paper-200 dark:bg-dark-border/40 border border-ink-border dark:border-dark-border text-ink dark:text-dark-ink shrink-0 mt-0.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="space-y-1.5">
            <h3 class="font-serif text-base sm:text-lg font-bold text-ink dark:text-dark-ink">
              The Invariant Rule of Verbatim Fidelity
            </h3>
            <p class="font-serif text-sm sm:text-base text-ink dark:text-dark-ink leading-relaxed">
              We re-engineer the vessel; we never tamper with the wine. We reject automated AI summaries, unauthorized paraphrasing, and destructive editorial pruning. Every insight, proof, and authorial turn of phrase remains intact. Re-architecture is an act of curatorial reverence, not editorial license.
            </p>
          </div>
        </div>
      </div>

      <!-- Section III -->
      <section>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-dark-ink tracking-tight mb-4">
          III. Editorial Dignity, Stability & Visual Stillness
        </h2>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed mb-4">
          Great typography requires emotional restraint. In AHKH Study Hub, we enforce a strict visual calm:
        </p>
        <ul class="space-y-4 my-6 font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="font-mono text-xs text-ink dark:text-dark-ink mt-1.5 shrink-0 font-bold" aria-hidden="true">—</span>
            <div>
              <strong class="font-medium text-ink dark:text-dark-ink">Minimal Motion:</strong> Zero frivolous bouncing elements, dizzying transitions, or parallax gimmicks. Micro-interactions exist solely to confirm state changes.
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="font-mono text-xs text-ink dark:text-dark-ink mt-1.5 shrink-0 font-bold" aria-hidden="true">—</span>
            <div>
              <strong class="font-medium text-ink dark:text-dark-ink">Absolute Ban on Emojis:</strong> Scholarly dignity is sustained through classical serif typefaces (<em class="italic">Merriweather</em>), crisp sans metrics (<em class="italic">Geist</em>), and clean geometric SVG icons.
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="font-mono text-xs text-ink dark:text-dark-ink mt-1.5 shrink-0 font-bold" aria-hidden="true">—</span>
            <div>
              <strong class="font-medium text-ink dark:text-dark-ink">Contained Proportions:</strong> The canvas never expands to swallow high-resolution displays. A disciplined, bookish measure (<code class="font-mono text-xs bg-paper-200 dark:bg-dark-border/60 px-1.5 py-0.5 rounded-2xs text-ink dark:text-dark-ink font-semibold">max-w-reading</code> / 68 characters) prevents eye exhaustion and preserves reading endurance.
            </div>
          </li>
        </ul>
      </section>

      <!-- Section IV: Comparative Dialectic (Responsive, No Horizontal Scroll) -->
      <section class="not-prose my-12">
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-dark-ink tracking-tight mb-3">
          IV. The Two Worlds of Digital Reading
        </h2>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed mb-6 font-medium">
          A comparative audit between the commercial web of extractive engagement and the quiet sanctuary of architectural scholarship:
        </p>

        <div class="space-y-4">
          <!-- Dimension 1: Emerald (Active / Foundational) -->
          <div class="border border-ink-border dark:border-dark-border rounded-xs p-5 bg-paper-50 dark:bg-dark-card transition-colors">
            <div class="font-mono text-xs uppercase tracking-widest text-emerald-700 dark:text-emerald-400 mb-3 font-medium flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
              Dimension 01 // Text Rendering
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 font-serif text-sm">
              <div class="p-3.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 text-ink/80 dark:text-dark-ink/80 border border-ink-border/60 dark:border-dark-border/60">
                <div class="font-mono text-[10px] uppercase tracking-wider text-ink/70 dark:text-dark-ink/70 font-semibold mb-1">Conventional Web</div>
                Uniform grey paragraphs, flat raw transcripts, and sterile walls of unshaped text.
              </div>
              <div class="p-3.5 rounded-xs bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border text-ink dark:text-dark-ink shadow-2xs font-medium">
                <div class="font-mono text-[10px] uppercase tracking-wider text-emerald-700 dark:text-emerald-400 font-bold mb-1">The Sanctuary Standard</div>
                Tactile containers, commanding pullouts, structured matrices, and rhythmic cadence.
              </div>
            </div>
          </div>

          <!-- Dimension 2: Blue (Architectural) -->
          <div class="border border-ink-border dark:border-dark-border rounded-xs p-5 bg-paper-50 dark:bg-dark-card transition-colors">
            <div class="font-mono text-xs uppercase tracking-widest text-blue-700 dark:text-blue-400 mb-3 font-medium flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
              Dimension 02 // Data Sovereignty
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 font-serif text-sm">
              <div class="p-3.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 text-ink/80 dark:text-dark-ink/80 border border-ink-border/60 dark:border-dark-border/60">
                <div class="font-mono text-[10px] uppercase tracking-wider text-ink/70 dark:text-dark-ink/70 font-semibold mb-1">Conventional Web</div>
                Notes and annotations locked behind recurring subscriptions and proprietary cloud silos.
              </div>
              <div class="p-3.5 rounded-xs bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border text-ink dark:text-dark-ink shadow-2xs font-medium">
                <div class="font-mono text-[10px] uppercase tracking-wider text-blue-700 dark:text-blue-400 font-bold mb-1">The Sanctuary Standard</div>
                100% Local browser storage with instantaneous, unencumbered CSV and Markdown export.
              </div>
            </div>
          </div>

          <!-- Dimension 3: Purple (Explored / Philosophical) -->
          <div class="border border-ink-border dark:border-dark-border rounded-xs p-5 bg-paper-50 dark:bg-dark-card transition-colors">
            <div class="font-mono text-xs uppercase tracking-widest text-purple-700 dark:text-purple-400 mb-3 font-medium flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-500" aria-hidden="true"></span>
              Dimension 03 // Original Fidelity
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 font-serif text-sm">
              <div class="p-3.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 text-ink/80 dark:text-dark-ink/80 border border-ink-border/60 dark:border-dark-border/60">
                <div class="font-mono text-[10px] uppercase tracking-wider text-ink/70 dark:text-dark-ink/70 font-semibold mb-1">Conventional Web</div>
                Aggressive AI summarization and editorial pruning that flattens nuanced human thought.
              </div>
              <div class="p-3.5 rounded-xs bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border text-ink dark:text-dark-ink shadow-2xs font-medium">
                <div class="font-mono text-[10px] uppercase tracking-wider text-purple-700 dark:text-purple-400 font-bold mb-1">The Sanctuary Standard</div>
                Zero authorial distortion; absolute verbatim fidelity to primary philosophical texts.
              </div>
            </div>
          </div>

          <!-- Dimension 4: Pink (Completed / Mastery) -->
          <div class="border border-ink-border dark:border-dark-border rounded-xs p-5 bg-paper-50 dark:bg-dark-card transition-colors">
            <div class="font-mono text-xs uppercase tracking-widest text-pink-700 dark:text-pink-400 mb-3 font-medium flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-pink-500" aria-hidden="true"></span>
              Dimension 04 // Reading Atmosphere
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 font-serif text-sm">
              <div class="p-3.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 text-ink/80 dark:text-dark-ink/80 border border-ink-border/60 dark:border-dark-border/60">
                <div class="font-mono text-[10px] uppercase tracking-wider text-ink/70 dark:text-dark-ink/70 font-semibold mb-1">Conventional Web</div>
                Flashing notification badges, bouncing popups, tracking telemetry, and commercial noise.
              </div>
              <div class="p-3.5 rounded-xs bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border text-ink dark:text-dark-ink shadow-2xs font-medium">
                <div class="font-mono text-[10px] uppercase tracking-wider text-pink-700 dark:text-pink-400 font-bold mb-1">The Sanctuary Standard</div>
                Dignified silence, stable typography, quiet palettes, and undisturbed mental stillness.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section V -->
      <section>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-ink dark:text-dark-ink tracking-tight mb-4">
          V. An Open Alternative to Walled Reading Gardens
        </h2>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed mb-4">
          Readwise Reader proved that unified digital study is essential for serious learning. But it bound that utility to recurring fees, proprietary databases, and closed ecosystems.
        </p>
        <p class="font-serif text-base sm:text-lg text-ink dark:text-dark-ink leading-relaxed">
          AHKH Study Hub stands as a permanent, zero-cost, open sanctuary. Your notes and marginalia are anchored directly to the passages that prompted them, stored securely inside your browser's local memory, and freely exportable at any instant into standard Readwise CSV schemas. No accounts. No subscriptions. Just focused, timeless scholarship.
        </p>
      </section>

    </article>

    <!-- Floating Highlight Popover for Manifesto -->
    <div 
      id="manifesto-popover" 
      class="hidden fixed z-50 bg-white dark:bg-dark-card text-ink dark:text-dark-ink px-3 py-1.5 rounded-xs shadow-lg shadow-black/5 dark:shadow-black/40 flex items-center gap-2 text-xs font-ui -translate-x-1/2 -translate-y-full mb-2 pointer-events-auto border border-ink-border dark:border-dark-border"
    >
      <button 
        id="popover-highlight-btn" 
        class="flex items-center gap-1.5 text-ink dark:text-dark-ink hover:text-emerald-700 dark:hover:text-emerald-400 font-medium transition-colors cursor-pointer font-ui"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m9 11-6 6v3h3l6-6"/><path d="m22 7-3-3a2.828 2.828 0 0 0-4 0l-10 10 4 4 10-10a2.828 2.828 0 0 0 0-4Z"/>
        </svg>
        <span>Save to Commonplace</span>
      </button>
    </div>

    <!-- Colophon: Dignified Architectural Closure -->
    <footer class="mt-16 pt-12 border-t border-ink-border dark:border-dark-border">
      <div class="p-6 sm:p-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-100/50 dark:bg-dark-card space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-ink-border/60 dark:border-dark-border/60 pb-6">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="flex gap-1" aria-hidden="true">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-pink-500"></span>
              </span>
              <span class="font-mono text-[11px] uppercase tracking-widest text-ink dark:text-dark-ink font-semibold">
                Sanctuary Specification // Canon 01
              </span>
            </div>
            <div class="font-serif text-lg font-bold text-ink dark:text-dark-ink">
              AHKH Study Hub
            </div>
          </div>
          <div class="font-mono text-xs text-ink/80 dark:text-dark-ink/80 font-medium">
            Offline-First · 100% Static · Local Storage
          </div>
        </div>

        <p class="font-serif text-sm text-ink dark:text-dark-ink leading-relaxed">
          This manifesto is not merely an ideological declaration; it is the living blueprint according to which every lesson, reading track, and marginal note in this hub is engineered. Select any passage above to preserve it in your Commonplace.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2">
          <a 
            href={path('/')} 
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xs bg-ink dark:bg-dark-ink text-paper-50 dark:text-dark-bg font-ui text-xs font-medium hover:bg-ink/90 dark:hover:bg-dark-ink/90 transition-colors"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            Return to Index of Curricula
          </a>
          <a 
            href={path('/commonplace')} 
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xs border border-ink-border dark:border-dark-border bg-white dark:bg-dark-card text-ink dark:text-dark-ink font-ui text-xs font-medium hover:bg-paper-200/50 dark:hover:bg-dark-border/40 transition-colors"
          >
            <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
            Review Saved Highlights
          </a>
        </div>
      </div>
    </footer>
  </main>

  <!-- Client-side Highlight Engine for Manifesto -->
  <script is:inline>
    (function() {
      // ClientRouter-safe boot: release the previous page's global listeners first.
      if (window.__ahkhManiAbort) { window.__ahkhManiAbort.abort(); }
      const __ahkhSignal = (window.__ahkhManiAbort = new AbortController()).signal;
      const STORAGE_KEY = 'ahkh_hl_manifesto';
      const popover = document.getElementById('manifesto-popover');
      const highlightBtn = document.getElementById('popover-highlight-btn');
      const content = document.getElementById('manifesto-content');
      let currentSelection = null;

      function loadHighlights() {
        try {
          const items = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          if (!Array.isArray(items) || items.length === 0) return;

          const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
          const textNodes = [];
          let node;
          while ((node = walker.nextNode())) {
            textNodes.push(node);
          }

          items.forEach(hl => {
            if (!hl.text) return;
            for (let tn of textNodes) {
              const idx = tn.nodeValue.indexOf(hl.text);
              if (idx !== -1 && !tn.parentElement.classList.contains('ahkh-highlight')) {
                const range = document.createRange();
                range.setStart(tn, idx);
                range.setEnd(tn, idx + hl.text.length);
                const span = document.createElement('span');
                span.className = 'ahkh-highlight';
                span.dataset.highlightId = hl.id;
                range.surroundContents(span);
                break;
              }
            }
          });
        } catch (err) {
          console.warn('Could not restore manifesto highlights:', err);
        }
      }

      function handleSelection() {
        const sel = window.getSelection();
        if (!sel || sel.isCollapsed || !content.contains(sel.anchorNode)) {
          popover?.classList.add('hidden');
          currentSelection = null;
          return;
        }

        const text = sel.toString().trim();
        if (text.length < 5) {
          popover?.classList.add('hidden');
          currentSelection = null;
          return;
        }

        const range = sel.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        
        currentSelection = {
          range: range.cloneRange(),
          text: text
        };

        if (popover) {
          popover.style.top = `${window.scrollY + rect.top - 8}px`;
          popover.style.left = `${window.scrollX + rect.left + rect.width / 2}px`;
          popover.classList.remove('hidden');
        }
      }

      document.addEventListener('selectionchange', () => {
        clearTimeout(window._selTimer);
        window._selTimer = setTimeout(handleSelection, 120);
      }, { signal: __ahkhSignal });

      highlightBtn?.addEventListener('click', () => {
        if (!currentSelection) return;
        const hlId = 'hl_' + Date.now();
        
        try {
          const span = document.createElement('span');
          span.className = 'ahkh-highlight';
          span.dataset.highlightId = hlId;
          currentSelection.range.surroundContents(span);

          const items = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
          items.push({
            id: hlId,
            text: currentSelection.text,
            lessonId: 'manifesto',
            lessonTitle: 'The Architecture of Literature',
            courseName: 'AHKH Canon',
            url: window.location.pathname,
            createdAt: new Date().toISOString()
          });
          localStorage.setItem(STORAGE_KEY, JSON.stringify(items));

          window.getSelection()?.removeAllRanges();
          popover?.classList.add('hidden');
          if (typeof window.updateGlobalBadge === 'function') {
            window.updateGlobalBadge();
          }
        } catch (err) {
          console.warn('Could not save highlight:', err);
        }
      });

      document.addEventListener('click', (e) => {
        if (popover && !popover.contains(e.target) && !window.getSelection()?.toString()) {
          popover.classList.add('hidden');
        }
      }, { signal: __ahkhSignal });

      // Single boot path: ClientRouter fires astro:page-load on initial load and navigation.
      document.addEventListener('astro:page-load', loadHighlights, { signal: __ahkhSignal });
    })();
  </script>
</BaseLayout>
