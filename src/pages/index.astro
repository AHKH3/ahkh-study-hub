---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/HubHeader.astro';
import { CATALOG_COURSES } from '../data/catalog';
import type { CourseStatus } from '../data/types';
import { path } from '../utils/paths';
import { getCategoryColor } from '../utils/categoryColors';

const STATUS_CONFIG: Record<CourseStatus, { label: string; dotClass: string; textClass: string }> = {
  active: {
    label: 'Active',
    dotClass: 'bg-amber-600 dark:bg-amber-400',
    textClass: 'text-amber-700 dark:text-amber-400',
  },
  new: {
    label: 'New',
    dotClass: 'bg-blue-600 dark:bg-blue-400',
    textClass: 'text-blue-700 dark:text-blue-400',
  },
  explored: {
    label: 'Exploring',
    dotClass: 'bg-purple-600 dark:bg-purple-400',
    textClass: 'text-purple-700 dark:text-purple-400',
  },
  completed: {
    label: 'Completed',
    dotClass: 'bg-emerald-600 dark:bg-emerald-400',
    textClass: 'text-emerald-700 dark:text-emerald-400',
  },
};
---

<BaseLayout title="Library — AHKH Study Hub" description="Curated library of intensive study curricula and open course companions.">
  <HubHeader activeTab="library" />

  <main class="flex-1 max-w-reading w-full mx-auto px-6 py-12">
    <!-- Header Section -->
    <div class="mb-10 flex items-baseline justify-between gap-4">
      <h1 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-ink dark:text-dark-ink">
        Index of Curricula
      </h1>
      <span class="font-mono text-xs text-ink-muted dark:text-dark-muted shrink-0">
        0{CATALOG_COURSES.length} {CATALOG_COURSES.length === 1 ? 'track' : 'tracks'}
      </span>
    </div>

    <!-- The Editorial Monograph List -->
    <div class="divide-y divide-ink-border/60 dark:divide-dark-border border-t border-b border-ink-border dark:border-dark-border mb-16">
      {CATALOG_COURSES.map((course, index) => {
        const num = String(index + 1).padStart(2, '0');
        const statusMeta = STATUS_CONFIG[course.status];
        return (
          <article class="group py-5 sm:py-6 transition-colors duration-150 hover:bg-paper-50 dark:hover:bg-dark-card/40 px-2 sm:px-4 -mx-2 sm:-mx-4 rounded-xs" data-course-id={course.id} data-lessons={course.lessonSlugs.join(',')}>
            <a href={path(`/courses/${course.slug}`)} data-astro-prefetch="hover" class="block focus:outline-none focus-visible:underline">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                
                <!-- Left: Number & Course Info -->
                <div class="flex items-start sm:items-center gap-4 sm:gap-6 min-w-0">
                  <span class="font-mono text-xs sm:text-sm text-ink-muted dark:text-dark-muted font-medium shrink-0 pt-0.5 sm:pt-0">
                    {num}
                  </span>
                  <div>
                    <div class="mb-1">
                      <span class={`font-mono text-[10px] sm:text-[11px] uppercase tracking-widest font-medium ${getCategoryColor(course.category)}`}>
                        {course.category}
                      </span>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                      <h2 class="font-serif text-xl sm:text-2xl font-medium text-ink dark:text-dark-ink group-hover:underline transition-colors">
                        {course.title}
                      </h2>
                      {statusMeta && (
                        <span class={`inline-flex items-center gap-1.5 text-[11px] font-mono tracking-widest ${statusMeta.textClass}`} data-statusbadge>
                          <span class={`w-1.5 h-1.5 rounded-full ${statusMeta.dotClass}`} data-statusdot></span>
                          {statusMeta.label}
                        </span>
                      )}
                    </div>
                    <!-- Metadata metrics: Module count, Source count, Duration -->
                    <div class="flex items-center gap-2.5 text-xs font-mono text-ink-muted dark:text-dark-muted mt-1.5">
                      <span><span class="font-medium text-ink dark:text-dark-ink">{course.totalModules}</span> Modules</span>
                      <span>·</span>
                      <span><span class="font-medium text-ink dark:text-dark-ink">{course.totalSources}</span> Sources</span>
                      {course.duration && (
                        <>
                          <span>·</span>
                          <span class="font-medium text-ink dark:text-dark-ink">{course.duration}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Right: Progress Indicator -->
                <div class="flex items-center shrink-0 pl-8 sm:pl-0">
                  <div class="flex items-center gap-2 font-mono text-xs text-ink dark:text-dark-ink">
                    <div class="w-24 sm:w-28 h-[3px] bg-paper-300 dark:bg-dark-border rounded-none overflow-hidden">
                      <div 
                        class="h-full bg-ink dark:bg-dark-ink transition-[width] duration-700 ease-out progress-fill"
                        data-role="progress-fill"
                        style={`width: ${course.progressPercent}%`}
                      ></div>
                    </div>
                    <span class="w-9 text-right font-medium progress-label">{course.progressPercent}%</span>
                  </div>
                </div>

              </div>
            </a>
          </article>
        );
      })}
    </div>

    <!-- Editorial Colophon Footer -->
    <footer class="pt-8 border-t border-ink-border/60 dark:border-dark-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-sans text-ink-muted dark:text-dark-muted">
      <p>A sovereign, local-first reading sanctuary for rigorous study curricula.</p>
      <a href={path('/manifesto')} data-astro-prefetch="hover" class="hover:text-ink dark:hover:text-dark-ink transition-colors underline underline-offset-4 flex items-center gap-1 font-ui">
        <span>Manifesto</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </footer>
  </main>

  <script is:inline>
    (function () {
      if (window.__ahkhLibAbort) {
        try { window.__ahkhLibAbort.abort(); } catch (e) {}
      }
      const __ahkhSignal = (window.__ahkhLibAbort = new AbortController()).signal;

      document.addEventListener('astro:before-swap', function () {
        try { window.__ahkhLibAbort?.abort(); } catch (e) {}
      }, { once: true });

      const STATUS_META = {
        active: { label: 'Active', dot: 'bg-amber-600 dark:bg-amber-400', text: 'text-amber-700 dark:text-amber-400' },
        new: { label: 'New', dot: 'bg-blue-600 dark:bg-blue-400', text: 'text-blue-700 dark:text-blue-400' },
        explored: { label: 'Exploring', dot: 'bg-purple-600 dark:bg-purple-400', text: 'text-purple-700 dark:text-purple-400' },
        completed: { label: 'Completed', dot: 'bg-emerald-600 dark:bg-emerald-400', text: 'text-emerald-700 dark:text-emerald-400' }
      };

      function refreshLibraryProgress() {
        try {
          if (typeof localStorage === 'undefined') return;
          const articles = document.querySelectorAll('article[data-course-id]');
          if (!articles || !articles.length) return;
          articles.forEach((article) => {
            try {
              const courseId = article.getAttribute('data-course-id');
              const lessonsAttr = article.getAttribute('data-lessons') || '';
              const slugs = lessonsAttr ? lessonsAttr.split(',').filter(Boolean) : [];
              const total = slugs.length;
              let read = 0;
              let reading = 0;
              let explored = 0;
              try {
                slugs.forEach((slug) => {
                  if (AhkhStorage.get(`ahkh_read_${courseId}_${slug}`) !== null) {
                    read += 1;
                  } else if (AhkhStorage.get(`ahkh_reading_${courseId}_${slug}`) !== null) {
                    reading += 1;
                  } else if (AhkhStorage.get(`ahkh_opened_${courseId}_${slug}`) !== null) {
                    explored += 1;
                  }
                });
              } catch (e) {}
              const percent = total ? Math.round((read / total) * 100) : 0;
              const fill = article.querySelector('[data-role="progress-fill"]');
              if (fill) fill.style.width = percent + '%';
              const label = article.querySelector('.progress-label');
              if (label) label.textContent = percent + '%';

              let chosenState = 'new';
              if (percent === 100) {
                chosenState = 'completed';
              } else if (read > 0 || reading > 0) {
                chosenState = 'active';
              } else if (explored > 0) {
                chosenState = 'explored';
              }

              const badge = article.querySelector('[data-statusbadge]');
              const meta = STATUS_META[chosenState];
              if (badge && meta) {
                const dot = badge.querySelector('[data-statusdot]');
                if (dot) dot.className = `w-1.5 h-1.5 rounded-full ${meta.dot}`;
                ['text-emerald-700', 'dark:text-emerald-400', 'text-blue-700', 'dark:text-blue-400', 'text-purple-700', 'dark:text-purple-400', 'text-amber-700', 'dark:text-amber-400', 'text-slate-600', 'dark:text-slate-400', 'text-pink-700', 'dark:text-pink-400'].forEach((c) => badge.classList.remove(c));
                meta.text.split(' ').forEach((c) => badge.classList.add(c));
                const textNode = Array.from(badge.childNodes).find((n) => n.nodeType === 3 && n.textContent.trim() !== '');
                if (textNode) textNode.textContent = ` ${meta.label}`;
                else badge.append(document.createTextNode(` ${meta.label}`));
              }
            } catch (e) {}
          });
        } catch (e) {}
      }

      window.__ahkhLibBoot = true;
      document.addEventListener('astro:page-load', refreshLibraryProgress, { signal: __ahkhSignal });
      if (document.readyState === 'complete') {
        refreshLibraryProgress();
      }

      // Session-persistent refresh (stale-state repair): inline scripts do not
      // re-execute when returning via ClientRouter, and the per-run listener
      // above is aborted on before-swap. This once-per-session binding keeps
      // library progress and status badges correct without reload.
      window.__ahkhRefreshLibrary = refreshLibraryProgress;
      if (!window.__ahkhLibPersistBound) {
        window.__ahkhLibPersistBound = true;
        document.addEventListener('astro:page-load', () => {
          try { window.__ahkhRefreshLibrary && window.__ahkhRefreshLibrary(); } catch (e) {}
        });
      }
    })();
  </script>
</BaseLayout>
