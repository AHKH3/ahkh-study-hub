---
import BaseLayout from '../layouts/BaseLayout.astro';
import HubHeader from '../components/HubHeader.astro';
import { path } from '../utils/paths';
---

<BaseLayout 
  title="The Commonplace Book — AHKH Study Hub" 
  description="Living treasury of extracted scholarly passages, marginal reflections, and philosophical axioms."
>
  <HubHeader activeTab="commonplace" />

  <main class="flex-1 max-w-hub w-full mx-auto px-6 py-12">
    <!-- Header with Action Buttons & Canonical Rubric -->
    <header class="mb-10 pb-6 border-b border-ink-border dark:border-dark-border flex flex-col sm:flex-row sm:items-end justify-between gap-6 transition-colors">
      <div>
        <h1 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-ink dark:text-dark-ink">
          The Commonplace Book
        </h1>
      </div>

      <!-- Sovereign Export Actions -->
      <div class="flex items-center gap-2.5 shrink-0">
        <button 
          id="export-markdown-btn"
          class="px-3.5 py-2 text-xs font-ui font-medium rounded-xs border border-ink-border dark:border-dark-border bg-paper-100 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink transition-colors flex items-center gap-2 cursor-pointer shadow-2xs disabled:opacity-40 disabled:cursor-not-allowed"
          title="Export all highlights to universal Markdown format"
        >
          <svg class="w-3.5 h-3.5 text-ink dark:text-dark-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="2"/><path d="m7 15 3-6 3 6M14 13h4M14 9h4"/>
          </svg>
          <span>Export Markdown</span>
        </button>

        <button 
          id="export-readwise-btn"
          class="px-3.5 py-2 text-xs font-ui font-medium rounded-xs bg-ink dark:bg-dark-ink text-paper-50 dark:text-dark-bg hover:bg-ink/90 dark:hover:bg-dark-ink/90 transition-colors flex items-center gap-2 shadow-xs cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
          title="Export in official Readwise CSV schema"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          <span>Readwise (CSV)</span>
        </button>
      </div>
    </header>

    <!-- Controls Bar: Search & Compact Filter Dropdown Menu -->
    <div class="mb-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <!-- Search Input Bar -->
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-ink-muted dark:text-dark-muted">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
        <input 
          type="text" 
          id="commonplace-search"
          aria-label="Filter highlights or notes"
          placeholder="Search by keyword, lesson title, or marginal thoughts... (Press / to focus)"
          class="w-full pl-10 pr-20 py-2.5 text-sm font-sans rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card text-ink dark:text-dark-ink placeholder:text-ink-faint dark:placeholder:text-dark-muted focus:outline-hidden focus:ring-1 focus:ring-ink/20 dark:focus:ring-dark-ink/30 focus:border-ink dark:focus:border-dark-ink transition-colors"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-1.5">
          <button 
            id="clear-search-btn" 
            class="hidden text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink p-1 rounded-xs transition-colors cursor-pointer"
            title="Clear search"
            aria-label="Clear search"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
          <kbd class="hidden sm:inline font-mono text-[10px] px-1.5 py-0.5 rounded border border-ink-border/80 dark:border-dark-border/80 text-ink-muted dark:text-dark-muted bg-paper-100 dark:bg-dark-bg select-none" aria-hidden="true">
            /
          </kbd>
        </div>
      </div>

      <!-- Compact Filter Dropdown Menu (Takes up single button space) -->
      <div class="relative shrink-0" id="filter-dropdown-wrapper">
        <button 
          id="filter-dropdown-btn"
          aria-haspopup="true"
          aria-expanded="false"
          class="w-full sm:w-auto px-3.5 py-2.5 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-100 dark:hover:bg-dark-border/40 text-ink dark:text-dark-ink text-xs font-ui font-medium transition-colors cursor-pointer flex items-center justify-between sm:justify-start gap-2.5 shadow-2xs"
          title="Filter passages by scope or curriculum"
        >
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-ink-muted dark:text-dark-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M3 6h18M7 12h10M10 18h4"/>
            </svg>
            <span class="text-ink-muted dark:text-dark-muted">Filter:</span>
            <span id="active-filter-label" class="font-medium text-ink dark:text-dark-ink">All Passages</span>
          </div>
          <svg class="w-3.5 h-3.5 text-ink-muted dark:text-dark-muted transition-transform duration-150" id="filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <!-- Dropdown Menu Panel -->
        <div 
          id="filter-menu-panel" 
          class="hidden absolute right-0 mt-1.5 w-64 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card shadow-lg z-30 py-1 text-xs font-ui divide-y divide-ink-border/50 dark:divide-dark-border/50 transition-all"
          role="menu"
        >
          <!-- Primary General Scopes -->
          <div class="py-1">
            <button 
              data-filter="all" 
              role="menuitem"
              class="filter-menu-option w-full px-3 py-2 text-left flex items-center justify-between hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer text-ink dark:text-dark-ink font-medium"
            >
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-ink dark:text-dark-ink opacity-100 filter-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
                <span>All Passages</span>
              </div>
              <span id="tab-count-all" class="font-mono text-[11px] text-ink-muted dark:text-dark-muted">0</span>
            </button>

            <button 
              data-filter="notes-only" 
              role="menuitem"
              class="filter-menu-option w-full px-3 py-2 text-left flex items-center justify-between hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer text-ink-muted dark:text-dark-muted"
            >
              <div class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-ink dark:text-dark-ink opacity-0 filter-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"/>
                </svg>
                <span>With Marginalia Only</span>
              </div>
              <span id="tab-count-notes" class="font-mono text-[11px] text-ink-muted dark:text-dark-muted">0</span>
            </button>
          </div>

          <!-- Dynamic Courses List -->
          <div class="py-1">
            <div class="px-3 py-1 font-mono text-[10px] uppercase tracking-wider text-ink-muted dark:text-dark-muted font-medium">
              Curricula & Sources
            </div>
            <div id="dynamic-courses-menu" class="max-h-52 overflow-y-auto">
              <!-- Dynamically populated via client script -->
            </div>
          </div>
        </div>
      </div>

      <!-- Highlights Counter -->
      <div id="highlights-counter" class="text-xs font-mono text-ink-muted dark:text-dark-muted shrink-0 text-right sm:text-left self-center" aria-live="polite">
        0 Highlights
      </div>
    </div>

    <!-- State 1: Global Empty State (Pristine Notebook) -->
    <div id="empty-state" class="hidden text-center py-20 px-6 border border-ink-border/60 dark:border-dark-border/60 rounded-xs bg-paper-100/40 dark:bg-dark-card/40 transition-colors">
      <div class="w-10 h-10 mx-auto mb-4 rounded-full bg-paper-200 dark:bg-dark-border/60 text-ink dark:text-dark-ink flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10M6 10h10"/>
        </svg>
      </div>
      <h2 class="font-serif text-2xl font-medium text-ink dark:text-dark-ink mb-2">
        Your Commonplace Book is Pristine
      </h2>
      <p class="font-serif text-sm sm:text-base text-ink-muted dark:text-dark-muted max-w-md mx-auto mb-8 leading-relaxed">
        As you read lessons and texts in the hub, select any passage to record enduring insights and marginalia. They will gather here in your personal treasury.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href={path('/courses/springboard-ux/the-anatomy-of-product-experience')} 
          class="inline-flex items-center gap-2 text-xs font-ui font-medium px-4 py-2.5 rounded-xs bg-ink dark:bg-dark-ink text-paper-50 dark:text-dark-bg hover:bg-ink/90 dark:hover:bg-dark-ink/90 transition-colors"
        >
          <span>Explore Springboard UX</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a 
          href={path('/manifesto')} 
          class="inline-flex items-center gap-2 text-xs font-ui font-medium px-4 py-2.5 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card text-ink dark:text-dark-ink hover:bg-paper-200 dark:hover:bg-dark-border/40 transition-colors"
        >
          <span>Highlight The Manifesto</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- State 2: No Search/Filter Results Found -->
    <div id="no-results-state" class="hidden text-center py-16 px-6 border border-ink-border/60 dark:border-dark-border/60 rounded-xs bg-paper-50 dark:bg-dark-card transition-colors">
      <div class="font-serif text-lg font-medium text-ink dark:text-dark-ink mb-1.5">
        No Passages Match Your Query
      </div>
      <p id="no-results-message" class="font-serif text-sm text-ink-muted dark:text-dark-muted max-w-sm mx-auto mb-5 leading-relaxed">
        No highlights match the current keyword or filter criteria.
      </p>
      <button 
        id="reset-filter-btn" 
        class="inline-flex items-center gap-1.5 text-xs font-ui font-medium px-3.5 py-2 rounded-xs border border-ink-border dark:border-dark-border bg-paper-100 dark:bg-dark-bg text-ink dark:text-dark-ink hover:bg-paper-200 dark:hover:bg-dark-border/60 transition-colors cursor-pointer"
      >
        Clear Search & Filters
      </button>
    </div>

    <!-- Highlights Feed (Editorial Flow) -->
    <div id="highlights-container" class="divide-y divide-ink-border/60 dark:divide-dark-border/60">
      <!-- Dynamically populated via client script -->
    </div>
  </main>

  <!-- Floating Undo Toast (6-Second Grace Period) -->
  <div 
    id="undo-toast" 
    class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-white dark:bg-dark-card text-ink dark:text-dark-ink px-4 py-3 rounded-xs shadow-lg shadow-black/5 dark:shadow-black/40 border border-ink-border dark:border-dark-border flex items-center gap-3 text-xs font-sans transition-all pointer-events-auto"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-ink-muted dark:text-dark-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
      </svg>
      <span id="undo-toast-message">Passage archived.</span>
    </div>
    <button 
      id="undo-btn" 
      class="font-mono text-ink dark:text-dark-ink underline font-medium hover:text-ink-muted cursor-pointer ml-1"
    >
      Undo (Ctrl+Z)
    </button>
  </div>

  <script is:inline>
  (function() {
    // ClientRouter-safe boot: release the previous page's global listeners first.
    if (window.__ahkhCommonAbort) { window.__ahkhCommonAbort.abort(); }
    const __ahkhSignal = (window.__ahkhCommonAbort = new AbortController()).signal;
    let currentFilter = 'all';
    let searchQuery = '';
    let pendingDeletion = null;
    let debounceTimer = null;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function escapeAttr(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function getAllHighlights() {
      const all = [];
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('ahkh_hl_')) {
          try {
            const list = JSON.parse(localStorage.getItem(key) || '[]');
            if (Array.isArray(list)) {
              list.forEach(item => {
                if (item && item.text) {
                  all.push({ ...item, _storageKey: key });
                }
              });
            }
          } catch (e) {
            console.warn('Error reading key:', key, e);
          }
        }
      }
      return all.sort((a, b) => {
        const tA = new Date(b.createdAt || b.timestamp || 0).getTime();
        const tB = new Date(a.createdAt || a.timestamp || 0).getTime();
        return tA - tB;
      });
    }

    function updateExportButtons(totalCount) {
      const mdBtn = document.getElementById('export-markdown-btn');
      const rwBtn = document.getElementById('export-readwise-btn');
      const isDisabled = totalCount === 0;

      if (mdBtn) mdBtn.disabled = isDisabled;
      if (rwBtn) rwBtn.disabled = isDisabled;
    }

    function buildFilterMenu(allItems) {
      const dynamicMenu = document.getElementById('dynamic-courses-menu');
      const tabCountAll = document.getElementById('tab-count-all');
      const tabCountNotes = document.getElementById('tab-count-notes');
      const activeLabel = document.getElementById('active-filter-label');
      
      const notesCount = allItems.filter(h => h.note && h.note.trim().length > 0).length;
      if (tabCountAll) tabCountAll.textContent = allItems.length;
      if (tabCountNotes) tabCountNotes.textContent = notesCount;

      // Extract unique course names
      const courses = {};
      allItems.forEach(item => {
        const c = (item.courseName || item.courseTitle || 'Other Curricula').trim();
        courses[c] = (courses[c] || 0) + 1;
      });

      if (dynamicMenu) {
        if (Object.keys(courses).length === 0) {
          dynamicMenu.innerHTML = '<div class="px-3 py-1.5 text-[11px] text-ink-muted dark:text-dark-muted italic">No courses recorded</div>';
        } else {
          dynamicMenu.innerHTML = Object.entries(courses).map(([courseName, count]) => {
            const isActive = currentFilter === courseName;
            let dotColor = 'bg-ink-muted dark:bg-dark-muted';
            const cn = courseName.toLowerCase();
            if (cn.includes('springboard')) dotColor = 'bg-ink dark:bg-dark-ink';
            else if (cn.includes('canon') || cn.includes('manifesto')) dotColor = 'bg-emerald-500';
            else if (cn.includes('systems') || cn.includes('architecture')) dotColor = 'bg-blue-500';
            else if (cn.includes('typography') || cn.includes('swiss')) dotColor = 'bg-pink-500';
            else dotColor = 'bg-purple-500';

            return `
              <button 
                data-filter="${escapeAttr(courseName)}" 
                role="menuitem"
                class="filter-menu-option w-full px-3 py-2 text-left flex items-center justify-between hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer ${isActive ? 'text-ink dark:text-dark-ink font-medium bg-paper-100/60 dark:bg-dark-border/20' : 'text-ink-muted dark:text-dark-muted'}"
              >
                <div class="flex items-center gap-2 min-w-0 pr-2">
                  <svg class="w-3.5 h-3.5 shrink-0 text-ink dark:text-dark-ink ${isActive ? 'opacity-100' : 'opacity-0'} filter-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                  <span class="w-1.5 h-1.5 rounded-full shrink-0 ${dotColor}" aria-hidden="true"></span>
                  <span class="truncate">${escapeHtml(courseName)}</span>
                </div>
                <span class="font-mono text-[11px] text-ink-muted dark:text-dark-muted shrink-0">${count}</span>
              </button>
            `;
          }).join('');
        }
      }

      // Update active filter label in button trigger
      if (activeLabel) {
        if (currentFilter === 'all') {
          activeLabel.textContent = 'All Passages';
        } else if (currentFilter === 'notes-only') {
          activeLabel.textContent = 'With Marginalia';
        } else {
          activeLabel.textContent = currentFilter;
        }
      }

      // Synchronize active checkmarks on static options
      document.querySelectorAll('.filter-menu-option').forEach(opt => {
        const isSel = opt.getAttribute('data-filter') === currentFilter;
        const check = opt.querySelector('.filter-check');
        if (check) {
          check.classList.toggle('opacity-100', isSel);
          check.classList.toggle('opacity-0', !isSel);
        }
        if (isSel) {
          opt.classList.add('text-ink', 'dark:text-dark-ink', 'font-medium', 'bg-paper-100/60', 'dark:bg-dark-border/20');
          opt.classList.remove('text-ink-muted', 'dark:text-dark-muted');
        } else {
          opt.classList.remove('text-ink', 'dark:text-dark-ink', 'font-medium', 'bg-paper-100/60', 'dark:bg-dark-border/20');
          opt.classList.add('text-ink-muted', 'dark:text-dark-muted');
        }
      });
    }

    function renderCommonplace() {
      const container = document.getElementById('highlights-container');
      const emptyState = document.getElementById('empty-state');
      const noResultsState = document.getElementById('no-results-state');
      const noResultsMessage = document.getElementById('no-results-message');
      const counter = document.getElementById('highlights-counter');
      const clearSearchBtn = document.getElementById('clear-search-btn');

      if (!container) return;

      const allItems = getAllHighlights();
      updateExportButtons(allItems.length);
      buildFilterMenu(allItems);

      // Manage Global Empty State (Pristine)
      if (allItems.length === 0) {
        container.innerHTML = '';
        emptyState?.classList.remove('hidden');
        noResultsState?.classList.add('hidden');
        if (counter) counter.textContent = '0 Highlights';
        return;
      }
      emptyState?.classList.add('hidden');

      // Filter by category/course
      let filtered = allItems;
      if (currentFilter === 'notes-only') {
        filtered = filtered.filter(h => h.note && h.note.trim().length > 0);
      } else if (currentFilter !== 'all') {
        filtered = filtered.filter(h => (h.courseName || h.courseTitle || '').trim() === currentFilter);
      }

      // Filter by search query
      const q = searchQuery.trim().toLowerCase();
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', q.length === 0);
      }

      if (q.length > 0) {
        filtered = filtered.filter(h => 
          (h.text && h.text.toLowerCase().includes(q)) || 
          (h.note && h.note.toLowerCase().includes(q)) ||
          (h.courseName && h.courseName.toLowerCase().includes(q)) ||
          (h.courseTitle && h.courseTitle.toLowerCase().includes(q)) ||
          (h.lessonTitle && h.lessonTitle.toLowerCase().includes(q))
        );
      }

      if (counter) {
        counter.textContent = `${filtered.length} Highlight${filtered.length === 1 ? '' : 's'}`;
      }

      // Manage Search/Filter Zero State
      if (filtered.length === 0) {
        container.innerHTML = '';
        noResultsState?.classList.remove('hidden');
        if (noResultsMessage) {
          if (q.length > 0) {
            noResultsMessage.textContent = `No passages match "${searchQuery}" in ${currentFilter === 'all' ? 'any collection' : currentFilter}.`;
          } else {
            noResultsMessage.textContent = `No passages found in selected filter: ${currentFilter}.`;
          }
        }
        return;
      }
      noResultsState?.classList.add('hidden');

      // Render Editorial Highlights Feed
      container.innerHTML = filtered.map(item => {
        const rawDate = item.createdAt || item.timestamp;
        const dateStr = rawDate ? new Date(rawDate).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) : '';
        const courseName = item.courseName || item.courseTitle || 'Curriculum';
        const lessonTitle = item.lessonTitle || 'Lesson';
        
        let dotColor = 'bg-ink-muted dark:bg-dark-muted';
        const cn = courseName.toLowerCase();
        if (cn.includes('springboard')) {
          dotColor = 'bg-ink dark:bg-dark-ink';
        } else if (cn.includes('canon') || cn.includes('manifesto')) {
          dotColor = 'bg-emerald-500';
        } else if (cn.includes('systems') || cn.includes('architecture')) {
          dotColor = 'bg-blue-500';
        } else if (cn.includes('typography') || cn.includes('swiss')) {
          dotColor = 'bg-pink-500';
        } else {
          dotColor = 'bg-purple-500';
        }

        // Direct anchor link to the highlighted text inside the lesson
        const targetUrl = item.url ? `${item.url}${item.id ? '#' + item.id : ''}` : '#';

        return `
          <article class="py-7 border-b border-ink-border/60 dark:border-dark-border/60 first:pt-4 last:border-b-0 space-y-3 transition-colors" data-id="${escapeAttr(item.id)}">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
              <div class="flex items-center flex-wrap gap-2 text-xs font-mono">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-2xs border border-ink-border dark:border-dark-border bg-paper-100 dark:bg-dark-card text-[11px] font-medium text-ink dark:text-dark-ink">
                  <span class="w-1.5 h-1.5 rounded-full ${dotColor}" aria-hidden="true"></span>
                  <span>${escapeHtml(courseName)}</span>
                </span>
                <span class="text-ink-faint dark:text-dark-muted" aria-hidden="true">/</span>
                <a 
                  href="${escapeHtml(targetUrl)}" 
                  class="text-ink dark:text-dark-ink font-medium hover:underline transition-colors"
                  title="Jump to highlighted passage in lesson"
                >
                  ${escapeHtml(lessonTitle)}
                </a>
              </div>

              <div class="flex items-center gap-2 self-end sm:self-auto">
                <time class="text-[11px] font-mono text-ink-muted dark:text-dark-muted" datetime="${escapeAttr(rawDate || '')}">
                  ${escapeHtml(dateStr)}
                </time>

                <button 
                  onclick="copyPassageText(this)"
                  data-quote="${escapeAttr(item.text)}"
                  class="p-1.5 rounded-xs text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:bg-paper-200/60 dark:hover:bg-dark-border/60 transition-colors cursor-pointer flex items-center justify-center min-w-[28px] min-h-[28px]"
                  title="Copy quote text"
                  aria-label="Copy quote text"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                  </svg>
                </button>

                <button 
                  onclick="initiateArchive('${escapeAttr(item.id)}')"
                  class="p-1.5 rounded-xs text-ink-muted dark:text-dark-muted hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors cursor-pointer flex items-center justify-center min-w-[28px] min-h-[28px]"
                  title="Archive passage"
                  aria-label="Archive passage"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>
            </div>

            <blockquote class="font-serif text-lg sm:text-xl leading-relaxed text-ink dark:text-dark-ink italic pl-5 border-l-2 border-ink-border dark:border-dark-border my-2.5 max-w-reading">
              ${escapeHtml(item.text)}
            </blockquote>

            ${item.note && item.note.trim() ? `
              <div class="p-3.5 rounded-xs bg-paper-100/70 dark:bg-dark-card border border-ink-border/80 dark:border-dark-border flex items-start gap-3 max-w-reading transition-colors">
                <div class="text-ink-muted dark:text-dark-muted shrink-0 mt-0.5" aria-hidden="true">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                  </svg>
                </div>
                <div class="space-y-0.5">
                  <div class="font-mono text-[11px] uppercase tracking-wider text-ink-muted dark:text-dark-muted font-medium">
                    Marginalia
                  </div>
                  <p class="font-sans text-sm text-ink dark:text-dark-ink leading-relaxed">
                    ${escapeHtml(item.note)}
                  </p>
                </div>
              </div>
            ` : ''}
          </article>
        `;
      }).join('');
    }

    // Copy Quote Functionality
    window.copyPassageText = function(btn) {
      const text = btn.getAttribute('data-quote');
      if (!text) return;

      navigator.clipboard.writeText(text).then(() => {
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 6 9 17l-5-5"/>
          </svg>
        `;
        btn.title = "Copied!";
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.title = "Copy quote text";
        }, 1800);
      }).catch(err => {
        console.warn('Clipboard write failed:', err);
      });
    };

    // Safe Deletion with Floating Undo Toast
    window.initiateArchive = function(id) {
      if (pendingDeletion) {
        commitPendingDeletion();
      }

      let foundItem = null;
      let foundKey = null;
      let foundIndex = -1;

      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('ahkh_hl_')) {
          try {
            const list = JSON.parse(localStorage.getItem(key) || '[]');
            const idx = list.findIndex(h => h.id === id);
            if (idx !== -1) {
              foundItem = list[idx];
              foundKey = key;
              foundIndex = idx;
              break;
            }
          } catch (e) {}
        }
      }

      if (!foundItem) return;

      // Temporarily remove from localStorage to reflect in memory
      try {
        const list = JSON.parse(localStorage.getItem(foundKey) || '[]');
        const updated = list.filter(h => h.id !== id);
        localStorage.setItem(foundKey, JSON.stringify(updated));
      } catch (e) {}

      // Show Undo Toast
      const undoToast = document.getElementById('undo-toast');
      const undoMessage = document.getElementById('undo-toast-message');
      if (undoMessage) undoMessage.textContent = 'Passage archived.';
      undoToast?.classList.remove('hidden');

      // Schedule definitive commit after 6 seconds
      const timer = setTimeout(() => {
        finalizeDeletion();
      }, 6000);

      pendingDeletion = {
        item: foundItem,
        key: foundKey,
        index: foundIndex,
        timer: timer
      };

      renderCommonplace();
      if (typeof window.updateGlobalBadge === 'function') {
        window.updateGlobalBadge();
      }
    };

    function commitPendingDeletion() {
      if (!pendingDeletion) return;
      clearTimeout(pendingDeletion.timer);
      pendingDeletion = null;
      document.getElementById('undo-toast')?.classList.add('hidden');
    }

    function finalizeDeletion() {
      commitPendingDeletion();
      if (typeof window.updateGlobalBadge === 'function') {
        window.updateGlobalBadge();
      }
    }

    window.undoArchive = function() {
      if (!pendingDeletion) return;

      clearTimeout(pendingDeletion.timer);
      const { item, key, index } = pendingDeletion;

      try {
        const list = JSON.parse(localStorage.getItem(key) || '[]');
        list.splice(index, 0, item);
        localStorage.setItem(key, JSON.stringify(list));
      } catch (e) {
        console.warn('Could not restore item:', e);
      }

      pendingDeletion = null;
      document.getElementById('undo-toast')?.classList.add('hidden');

      renderCommonplace();
      if (typeof window.updateGlobalBadge === 'function') {
        window.updateGlobalBadge();
      }
    };

    // Export to Readwise CSV (Sanitized & UTF-8 BOM)
    function exportReadwiseCsv() {
      const items = getAllHighlights();
      if (items.length === 0) return;

      const headers = ['Highlight', 'Book Title', 'Book Author', 'URL', 'Note', 'Location', 'Date'];
      
      const sanitizeCell = (val) => {
        let str = (val || '').toString().trim();
        if (/^[=+\-@]/.test(str)) {
          str = "'" + str;
        }
        return `"${str.replace(/"/g, '""')}"`;
      };

      const rows = items.map(item => [
        sanitizeCell(item.text),
        sanitizeCell(item.courseName || item.courseTitle || 'AHKH Canon'),
        `"AHKH Study Hub"`,
        sanitizeCell(item.url ? window.location.origin + item.url + (item.id ? '#' + item.id : '') : ''),
        sanitizeCell(item.note),
        sanitizeCell(item.lessonTitle || 'Lesson'),
        sanitizeCell(item.createdAt || item.timestamp || new Date().toISOString())
      ]);

      const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `ahkh-readwise-highlights-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);
    }

    // Export to Markdown (Sovereign & Hierarchical)
    function exportMarkdown() {
      const items = getAllHighlights();
      if (items.length === 0) return;

      const grouped = {};
      items.forEach(item => {
        const c = item.courseName || item.courseTitle || 'AHKH Canon';
        if (!grouped[c]) grouped[c] = [];
        grouped[c].push(item);
      });

      let md = `# AHKH Study Hub — The Commonplace Book\n`;
      md += `*Exported on ${new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' })}*\n\n`;
      md += `Total Passages: ${items.length}\n\n---\n\n`;

      Object.entries(grouped).forEach(([course, courseItems]) => {
        md += `## ${course}\n\n`;
        courseItems.forEach(item => {
          const rawDate = item.createdAt || item.timestamp;
          const dateStr = rawDate ? new Date(rawDate).toLocaleDateString() : '';
          const targetUrl = item.url ? window.location.origin + item.url + (item.id ? '#' + item.id : '') : '';

          md += `### ${item.lessonTitle || 'Lesson'}\n`;
          md += `> ${item.text.replace(/\n/g, '\n> ')}\n\n`;
          if (item.note && item.note.trim()) {
            md += `**Marginalia:** ${item.note}\n\n`;
          }
          md += `*Preserved ${dateStr ? dateStr + ' · ' : ''}[View in Lesson](${targetUrl})*\n\n`;
        });
        md += `---\n\n`;
      });

      const blob = new Blob([md], { type: 'text/markdown;charset=utf-8;' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `ahkh-commonplace-${new Date().toISOString().slice(0, 10)}.md`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);
    }

    // Event Listeners & State Initialization
    function initCommonplace() {
      renderCommonplace();

      const searchInput = document.getElementById('commonplace-search');
      searchInput?.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          searchQuery = e.target.value;
          renderCommonplace();
        }, 80);
      });

      document.getElementById('clear-search-btn')?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        renderCommonplace();
        searchInput?.focus();
      });

      const dropdownBtn = document.getElementById('filter-dropdown-btn');
      const menuPanel = document.getElementById('filter-menu-panel');
      const chevron = document.getElementById('filter-chevron');

      function toggleDropdown(show) {
        if (!menuPanel) return;
        const willShow = show !== undefined ? show : menuPanel.classList.contains('hidden');
        if (willShow) {
          menuPanel.classList.remove('hidden');
          dropdownBtn?.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
        } else {
          menuPanel.classList.add('hidden');
          dropdownBtn?.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('rotate-180');
        }
      }

      dropdownBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });

      menuPanel?.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-menu-option');
        if (!btn) return;
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        currentFilter = filter;
        toggleDropdown(false);
        renderCommonplace();
      });

      document.addEventListener('click', (e) => {
        const wrapper = document.getElementById('filter-dropdown-wrapper');
        if (wrapper && !wrapper.contains(e.target)) {
          toggleDropdown(false);
        }
      }, { signal: __ahkhSignal });

      document.getElementById('reset-filter-btn')?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        currentFilter = 'all';
        toggleDropdown(false);
        renderCommonplace();
      });

      document.getElementById('undo-btn')?.addEventListener('click', window.undoArchive);

      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
          e.preventDefault();
          searchInput?.focus();
        }
        if (e.key === 'Escape') {
          toggleDropdown(false);
          if (document.activeElement === searchInput) {
            if (searchInput.value.trim().length > 0) {
              searchInput.value = '';
              searchQuery = '';
              renderCommonplace();
            } else {
              searchInput.blur();
            }
          }
        }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
          if (pendingDeletion) {
            e.preventDefault();
            window.undoArchive();
          }
        }
      }, { signal: __ahkhSignal });

      document.getElementById('export-readwise-btn')?.addEventListener('click', exportReadwiseCsv);
      document.getElementById('export-markdown-btn')?.addEventListener('click', exportMarkdown);
    }

    // Single boot path: ClientRouter (always enabled in BaseLayout) fires
    // astro:page-load on initial load and on every navigation.
    document.addEventListener('astro:page-load', initCommonplace, { signal: __ahkhSignal });
  })();
</script>
</BaseLayout>
