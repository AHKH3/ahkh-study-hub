              <span class="hl-preview-tint w-3.5 h-3.5 rounded-2xs shrink-0" style="background: rgba(217, 119, 6, 0.22); border-bottom: 2px solid #D97706;"></span>
              <span class="text-xs font-medium text-ink dark:text-dark-ink">Classic Tint</span>
            </div>
            <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Wash + Border</span>
          </button>
          <button 
            data-hl-style="underline" 
            role="option"
            class="hl-style-opt-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          >
            <div class="flex items-center gap-2">
              <span class="hl-preview-underline w-3.5 h-3.5 shrink-0" style="background: transparent; border-bottom: 2px solid #D97706;"></span>
              <span class="text-xs font-medium text-ink dark:text-dark-ink">Minimal Underline</span>
            </div>
            <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Pure Underline</span>
          </button>
          <button 
            data-hl-style="bracket" 
            role="option"
            class="hl-style-opt-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          >
            <div class="flex items-center gap-2">
              <span class="hl-preview-bracket w-3.5 h-3.5 rounded-2xs shrink-0" style="background: rgba(217, 119, 6, 0.22); border-left: 2.5px solid #D97706;"></span>
              <span class="text-xs font-medium text-ink dark:text-dark-ink">Margin Bracket</span>
            </div>
            <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Wash + Margin</span>
          </button>
          <button 
            data-hl-style="wash" 
            role="option"
            class="hl-style-opt-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          >
            <div class="flex items-center gap-2">
              <span class="hl-preview-wash w-3.5 h-3.5 rounded-2xs shrink-0" style="background: rgba(217, 119, 6, 0.22); border: none;"></span>
              <span class="text-xs font-medium text-ink dark:text-dark-ink">Soft Wash</span>
            </div>
            <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Wash Only</span>
          </button>
          <button 
            data-hl-style="solid" 
            role="option"
            class="hl-style-opt-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          >
            <div class="flex items-center gap-2">
              <span class="hl-preview-solid w-3.5 h-3.5 rounded-2xs shrink-0" style="background: #D97706; border: none;"></span>
              <span class="text-xs font-medium text-ink dark:text-dark-ink">Solid Marker</span>
            </div>
            <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Contrast Text</span>
          </button>
        </div>
      </div>

      <!-- Auto-Highlight Instant Mode Toggle -->
      <div class="flex items-center justify-between pt-1">
        <div class="flex flex-col pr-2">
          <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Auto-Highlight</span>
          <span class="text-[10px] text-ink-muted dark:text-dark-muted leading-tight">Instant highlight on text selection</span>
        </div>
        <button
          type="button"
          id="toggle-auto-highlight-btn"
          role="switch"
          aria-checked="false"
          class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-paper-300 dark:bg-dark-border transition-colors duration-150 ease-out focus:outline-none"
          title="Toggle instant highlighting on selection"
        >
          <span
            id="auto-highlight-toggle-dot"
            class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white dark:bg-dark-card shadow-xs transition duration-150 ease-out translate-x-0"
          ></span>
        </button>
      </div>

      <!-- Default Color Palette -->
      <div>
        <div class="mb-1.5">
          <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Default Color</span>
        </div>
        <div class="flex items-center justify-between p-1.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60" role="radiogroup" aria-label="Default highlight color">
          <button type="button" data-hl-color="amber" title="Amber" aria-label="Amber" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#D97706"></button>
          <button type="button" data-hl-color="emerald" title="Emerald" aria-label="Emerald" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#059669"></button>
          <button type="button" data-hl-color="teal" title="Teal" aria-label="Teal" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#0D9488"></button>
          <button type="button" data-hl-color="sky" title="Sky" aria-label="Sky" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#0284C7"></button>
          <button type="button" data-hl-color="violet" title="Violet" aria-label="Violet" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#7C3AED"></button>
          <button type="button" data-hl-color="rose" title="Rose" aria-label="Rose" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#E11D48"></button>
          <button type="button" data-hl-color="graphite" title="Graphite" aria-label="Graphite" class="hl-settings-swatch w-6 h-6 rounded-full border border-ink-border dark:border-dark-border cursor-pointer transition-transform duration-150 flex items-center justify-center shrink-0" style="background:#52525B"></button>
        </div>
      </div>
    </div>

    <!-- 4. Reading Surface Palette -->
    <div class="pt-2 border-t border-ink-border/60 dark:border-dark-border/60">
      <div class="mb-1.5">
        <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Surface Theme</span>
      </div>
      <div class="grid grid-cols-2 gap-1.5 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
        <button id="theme-light-btn" class="theme-switch-btn py-1.5 px-2.5 rounded-xs text-center font-ui text-xs transition-colors duration-150 cursor-pointer flex items-center justify-center gap-1.5">
          <Sun class="w-3.5 h-3.5" />
          <span>Light</span>
        </button>
        <button id="theme-dark-btn" class="theme-switch-btn py-1.5 px-2.5 rounded-xs text-center font-ui text-xs transition-colors duration-150 cursor-pointer flex items-center justify-center gap-1.5">
          <Moon class="w-3.5 h-3.5" />
          <span>Dark</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MOBILE SIDEBAR BACKDROP OVERLAY -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-ink/20 dark:bg-black/60 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

  <!-- 3. THE 3-COLUMN STUDY DESK -->
  <div id="study-desk" class="flex-1 w-full pt-16 flex relative overflow-x-clip min-h-screen" data-course-id={course.id} data-course-title={course.title} data-lesson-id={lesson.id} data-lesson-slug={lesson.slug} data-lesson-title={lesson.title} data-course-accent={course.theme.accent} data-course-highlight={course.theme.highlight}>
    
    <!-- LEFT SIDEBAR: Outline / TOC Only -->
    <aside 
      id="left-sidebar"
      class="sidebar-drawer shrink-0 border-r border-ink-border/80 dark:border-dark-border bg-paper-100/95 dark:bg-dark-bg/95 backdrop-blur-md sticky overflow-y-auto overflow-x-hidden p-6"
    >
      <div class="w-52 min-w-[13rem]">
        <!-- Study Mode & Reading Status Card -->
        <div id="sidebar-study-card" class="mb-5 pb-4 border-b border-ink-border/60 dark:border-dark-border">
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-muted dark:text-dark-muted font-semibold">Reading State</span>
            <span id="lesson-status-badge" class="inline-flex items-center gap-1.5 font-mono text-[11px] font-medium tracking-widest text-purple-700 dark:text-purple-400">
              <span id="lesson-status-dot" class="w-1.5 h-1.5 rounded-full bg-purple-600 dark:bg-purple-400"></span>
              <span id="lesson-status-text">Exploring</span>
            </span>
          </div>

          <!-- Start Reading Action Button (shown in Exploring state) -->
          <button
            type="button"
            id="start-reading-btn"
            class="w-full font-ui text-xs font-medium py-1.5 px-2.5 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink transition-colors duration-150 cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs"
          >
            <span>Start Reading</span>
          </button>

          <!-- Reading Timestamp (shown when reading or completed) -->
          <div id="reading-timestamp-display" class="hidden font-mono text-[11px] text-ink-muted dark:text-dark-muted flex items-center justify-center gap-1.5 py-1">
            <svg class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span id="reading-timestamp-text"></span>
          </div>
        </div>

        <div class="font-mono text-[11px] uppercase tracking-widest text-ink dark:text-dark-ink font-semibold mb-4 pb-2 border-b border-ink-border/60 dark:border-dark-border/60">
          Document Outline
        </div>
        <nav class="space-y-2 text-xs font-sans">
          {lesson.outline.map((item) => (
            <a 
              href={`#${item.id}`}
              class:list={[
                "block text-ink/70 dark:text-dark-ink/70 hover:text-ink dark:hover:text-dark-ink transition-colors duration-150 line-clamp-1 py-1.5 px-2 hover:bg-paper-100 dark:hover:bg-dark-surface border-l-[2px] border-transparent hover:border-ink-muted dark:hover:border-dark-muted",
                item.level === 3 ? "ml-3 text-[11px]" : "font-medium"
              ]}
            >
              {item.title}
            </a>
          ))}
        </nav>

        <div class="mt-8 pt-4 border-t border-ink-border/60 dark:border-dark-border/60">
          <div class="font-mono text-[10px] text-ink/75 dark:text-dark-ink/75 font-semibold mb-1">Source Information</div>
          <a 
            href={lesson.originalSourceUrl || "#"} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[11px] text-ink dark:text-dark-ink hover:underline line-clamp-1 font-sans flex items-center gap-1"
          >
            {lesson.originalSourceLabel || "Original Material"} ↗
          </a>
        </div>
      </div>
    </aside>

    <!-- CENTER: Reading Sanctuary Canvas -->
    <main id="center-reading-column" class="flex-1 px-6 sm:px-12 py-10 max-w-reading mx-auto relative">
      
      <!-- Article Heading Block -->
      <div class="mb-10 pb-6 border-b border-ink-border/80 dark:border-dark-border">
        <div class="flex items-center gap-2 font-mono text-xs text-ink/80 dark:text-dark-ink/80 mb-2 font-medium">
          <span>Unit {lesson.unitNumber}</span>
          <span>·</span>
          <span>Lesson {lesson.lessonNumber}</span>
          <span>·</span>
          <span class={`font-medium ${getFormatColor(lesson.type)}`}>{lesson.type === 'video' ? 'Video' : lesson.type === 'pdf' ? 'PDF' : 'Article'}</span>
          <span>·</span>
          <span>{lesson.readTime} read</span>
        </div>

<h1 id="lesson-hero-title" class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-ink dark:text-dark-ink mb-5">
          {lesson.title}
        </h1>

        <p class="font-serif text-base sm:text-lg lg:text-xl text-ink/85 dark:text-dark-ink/85 italic leading-relaxed border-l-[3px] border-ink-border dark:border-dark-border pl-5 py-1">
          "{lesson.summaryQuote}"
        </p>
      </div>

      <!-- VIDEO PLAYER IF TYPE == VIDEO -->
      {lesson.type === 'video' && lesson.youtubeId && (
        <>
          <div id="video-scroll-sentinel" class="w-full h-px -mt-px pointer-events-none opacity-0" aria-hidden="true"></div>
          <div id="video-sticky-wrapper" class="video-sticky-wrapper mb-10 transition-transform duration-300 ease-out">
            <div class="video-player-card rounded-xs overflow-hidden border border-ink-border dark:border-dark-border bg-ink shadow-2xs transition-colors duration-150">
              <div class="video-aspect-box aspect-video w-full bg-ink transition-colors duration-150">
                <iframe 
                  id="youtube-player"
                  class="w-full h-full"
                  src={`https://www.youtube-nocookie.com/embed/${lesson.youtubeId}?enablejsapi=1&rel=0&modestbranding=1&playsinline=1`}
                  title={`Video lecture: ${lesson.title}`}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="p-2.5 bg-paper-200/90 dark:bg-dark-card border-t border-ink-border dark:border-dark-border flex flex-wrap items-center justify-between gap-3 text-xs font-sans">
                <span class="text-ink-muted dark:text-dark-muted flex items-center gap-1.5 font-medium">
                  <span class="w-2 h-2 rounded-full bg-rose-600 dark:bg-rose-400"></span>
                  <span>Video Lecture & Synced Transcript</span>
                </span>
                <div class="flex items-center gap-2.5">
                  <label class="flex items-center gap-1.5 cursor-pointer text-ink dark:text-dark-ink font-medium select-none text-[11px] sm:text-xs">
                    <input type="checkbox" id="auto-scroll-sync" checked class="rounded-xs text-ink accent-rose-600 cursor-pointer" />
                    <span>Auto-Scroll</span>
                  </label>
                  <div class="h-3.5 w-px bg-ink-border dark:bg-dark-border hidden sm:block"></div>
                  <button 
                    type="button" 
                    id="toggle-video-pin" 
                    class="font-ui text-[11px] sm:text-xs flex items-center gap-1 px-2 py-1 rounded-xs border border-ink-border/80 dark:border-dark-border text-ink dark:text-dark-ink bg-paper-50 dark:bg-dark-surface hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer select-none"
                    title="Toggle sticky video player when scrolling"
                    aria-pressed="true"
                  >
                    <svg class="w-3 h-3 text-rose-600 dark:text-rose-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="12" y1="17" x2="12" y2="22"/>
                      <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/>
                    </svg>
                    <span id="video-pin-label">Pinned</span>
                  </button>
                  <button 
                    type="button" 
                    id="toggle-video-compact" 
                    class="font-ui text-[11px] sm:text-xs flex items-center gap-1 px-2 py-1 rounded-xs border border-ink-border/80 dark:border-dark-border text-ink dark:text-dark-ink bg-paper-50 dark:bg-dark-surface hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer select-none"
                    title="Toggle compact video height when docked"
                    aria-pressed="false"
                  >
                    <svg class="w-3 h-3 text-ink-muted dark:text-dark-muted shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="4 14 10 14 10 20"/>
                      <polyline points="20 10 14 10 14 4"/>
                      <line x1="14" y1="10" x2="21" y2="3"/>
                      <line x1="3" y1="21" x2="10" y2="14"/>
                    </svg>
                    <span id="video-compact-label">Compact</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </>
      )}

      {/* VIDEO WITHOUT EMBED: dignified source-link fallback instead of a silent gap */}
      {lesson.type === 'video' && !lesson.youtubeId && lesson.originalSourceUrl && (
        <div class="mb-10 p-5 rounded-xs bg-paper-100 dark:bg-dark-card border border-ink-border dark:border-dark-border flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <span class="text-sm font-sans text-ink-muted dark:text-dark-muted">
            Video lecture hosted externally — watch it at the original source.
          </span>
          <a
            href={lesson.originalSourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-ui font-medium text-xs text-ink dark:text-dark-ink hover:underline underline-offset-4 shrink-0 flex items-center gap-1 border border-ink-border dark:border-dark-border px-3 py-1.5 rounded-xs bg-paper-50 dark:bg-dark-card hover:bg-paper-100"
          >
            Watch video ↗
          </a>
        </div>
      )}

      {/* TRANSCRIPT VIEW TOGGLE (video lessons): formatted study version vs verbatim original */}
      {lesson.type === 'video' && (
        <div class="mb-6 flex items-center justify-end">
          <div class="flex items-center gap-1 border border-ink-border dark:border-dark-border rounded-xs p-0.5 bg-paper-100 dark:bg-dark-card" role="tablist" aria-label="Transcript view">
            <button data-transcript-view="formatted" role="tab" class="transcript-tab px-3 py-1.5 text-xs font-ui font-medium rounded-xs border border-transparent transition-colors cursor-pointer">Formatted</button>
            <button data-transcript-view="original" role="tab" class="transcript-tab px-3 py-1.5 text-xs font-ui font-medium rounded-xs border border-transparent transition-colors cursor-pointer">Original script</button>
          </div>
        </div>
      )}

      <!-- THE EDITORIAL PROSE CONTENT -->
      <div 
        id="formatted-view" 
        class="prose-editorial relative"
        data-video-timestamps={lesson.type === 'video' && lesson.videoTimestamps ? JSON.stringify(lesson.videoTimestamps) : undefined}
      >
        <Fragment set:html={lesson.contentHtml} />
      </div>

      {/* VERBATIM ORIGINAL TRANSCRIPT (video lessons, auto-ingested at build time) */}
      {lesson.type === 'video' && (
        <div id="transcript-view" class="prose-editorial relative hidden">
          {transcriptSegments ? (
            <div class="space-y-3">
              {transcriptSegments.map((cue) => (
                <div
                  data-timestamp={cue.time}
                  class="transcript-cue group relative block w-full text-left p-4 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-card transition-colors duration-150 select-text"
                >
                  <div class="flex items-start gap-3">
                    <button
                      type="button"
                      class="timestamp-btn cue-timestamp shrink-0 inline-flex items-center gap-1.5 font-mono text-xs px-2 py-0.5 rounded-xs border border-ink-border/60 dark:border-dark-border/60 bg-paper-100 dark:bg-dark-surface text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hover:border-ink-border dark:hover:border-dark-border transition-colors duration-150 cursor-pointer"
                      data-seek-time={cue.time}
                      title={`Play lecture from ${cue.label}`}
                    >
                      <svg class="cue-playing-icon w-3 h-3 text-rose-600 dark:text-rose-400 hidden shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="6 3 20 12 6 21 6 3" fill="currentColor"/>
                      </svg>
                      <span>{cue.label}</span>
                    </button>
                    <p class="cue-text font-serif text-sm sm:text-base leading-relaxed text-ink/90 dark:text-dark-ink/90 select-text cursor-text flex-1">
                      {cue.text}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm font-sans text-ink-muted dark:text-dark-muted border-l-2 border-ink-border dark:border-dark-border pl-4">
              The verbatim original script for this lecture is pending ingestion. Run `npm run transcripts` to fetch its published captions; the formatted study version above preserves its full substance with synced timestamps.
            </p>
          )}
        </div>
      )}

      <!-- EDITORIAL READER FOOTER: Milestone Utility Bar + Sequential Continuation Cards -->
      <footer class="mt-20 pt-8 border-t border-ink-border/80 dark:border-dark-border">
        <!-- Tier 1: Lesson Milestone Action Bar (Roadmap, Status, Back to Top) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 text-xs font-ui">
          <!-- Left: Return to Curriculum Roadmap -->
          <a 
            href={path(`/courses/${course.slug}`)}
            data-astro-prefetch="hover"
            class="inline-flex items-center gap-2 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink transition-colors group"
            title="Return to Course Journey"
          >
            <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            <span class="font-medium">Curriculum Roadmap</span>
          </a>

          <!-- Center: Mark as Complete Toggle -->
          <div class="flex items-center justify-start sm:justify-center">
            <button
              id="toggle-lesson-completed-btn"
              type="button"
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-100 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink text-xs font-medium transition-colors cursor-pointer shadow-2xs"
              title="Toggle lesson completion status"
            >
              <span id="lesson-completed-icon" class="flex items-center text-ink-muted dark:text-dark-muted">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                </svg>
              </span>
              <span id="lesson-completed-label">Mark as complete</span>
            </button>
          </div>

          <!-- Right: Return to Top -->
          <div class="flex items-center justify-start sm:justify-end">
            <button 
              type="button"
              onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
              class="inline-flex items-center gap-1.5 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink font-mono text-xs transition-colors cursor-pointer"
              title="Scroll to top of lesson"
            >
              <span>Top</span>
              <span aria-hidden="true">&uarr;</span>
            </button>
          </div>
        </div>

        <!-- Tier 2: Dual Sequential Continuation Cards (Low-Contrast Quiet Editorial Layout) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-8 border-t border-ink-border/50 dark:border-dark-border/50">
          {prevLesson ? (
            <a 
              id="prev-lesson-card-btn"
              href={path(`/courses/${course.slug}/${prevLesson.slug}`)}
              data-astro-prefetch="hover"
              class="group block p-4 sm:p-5 rounded-xs border border-ink-border dark:border-dark-border bg-transparent hover:bg-paper-50/60 dark:hover:bg-dark-card/30 transition-colors duration-150"
              title={`Previous: ${prevLesson.title}`}
            >
              <div class="flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-widest text-ink-muted/80 dark:text-dark-muted/80 mb-2">
                <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
                <span>Previous Lesson</span>
                <span>·</span>
                <span>{prevLesson.lessonNumber}</span>
              </div>
              <h4 class="font-serif text-sm sm:text-base font-semibold text-ink/90 dark:text-dark-ink/90 group-hover:text-ink dark:group-hover:text-dark-ink transition-colors line-clamp-2 leading-snug mb-2">
                {prevLesson.title}
              </h4>
              <div class="flex items-center gap-2 font-mono text-xs text-ink-muted/80 dark:text-dark-muted/80">
                <span class={`font-medium ${getFormatColor(prevLesson.type)}`}>
                  {prevLesson.type === 'video' ? 'Video' : prevLesson.type === 'pdf' ? 'PDF' : 'Article'}
                </span>
                <span>·</span>
                <span>{prevLesson.readTime}</span>
              </div>
            </a>
          ) : (
            <div class="p-4 sm:p-5 rounded-xs border border-dashed border-ink-border/40 dark:border-dark-border/40 bg-paper-50/20 dark:bg-dark-card/10 flex flex-col justify-center">
              <div class="font-mono text-[11px] uppercase tracking-widest text-ink-muted/70 dark:text-dark-muted/70 mb-1">
                Curriculum Inception
              </div>
              <p class="font-serif text-xs sm:text-sm text-ink-muted/80 dark:text-dark-muted/80">
                This is the foundational monograph for this track.
              </p>
            </div>
          )}

          {nextLesson ? (
            <a 
              id="next-lesson-card-btn"
              href={path(`/courses/${course.slug}/${nextLesson.slug}`)}
              data-astro-prefetch="hover"
              class="group block p-4 sm:p-5 rounded-xs border border-ink-border dark:border-dark-border bg-transparent hover:bg-paper-50/60 dark:hover:bg-dark-card/30 transition-colors duration-150 sm:text-right"
              title={`Next: ${nextLesson.title}`}
            >
              <div class="flex items-center sm:justify-end gap-1.5 font-mono text-[11px] uppercase tracking-widest text-ink-muted/80 dark:text-dark-muted/80 mb-2">
                <span>{nextLesson.lessonNumber}</span>
                <span>·</span>
                <span>Next Lesson</span>
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </div>
              <h4 class="font-serif text-sm sm:text-base font-semibold text-ink/90 dark:text-dark-ink/90 group-hover:text-ink dark:group-hover:text-dark-ink transition-colors line-clamp-2 leading-snug mb-2">
                {nextLesson.title}
              </h4>
              <div class="flex items-center sm:justify-end gap-2 font-mono text-xs text-ink-muted/80 dark:text-dark-muted/80">
                <span class={`font-medium ${getFormatColor(nextLesson.type)}`}>
                  {nextLesson.type === 'video' ? 'Video' : nextLesson.type === 'pdf' ? 'PDF' : 'Article'}
                </span>
                <span>·</span>
                <span>{nextLesson.readTime}</span>
              </div>
            </a>
          ) : (
            <div class="p-4 sm:p-5 rounded-xs border border-ink-border/50 dark:border-dark-border/50 bg-paper-50/30 dark:bg-dark-card/20 flex flex-col justify-center sm:text-right">
              <div class="font-mono text-[11px] uppercase tracking-widest text-emerald-700/90 dark:text-emerald-400/90 font-medium mb-1">
                Track Completed
              </div>
              <p class="font-serif text-xs sm:text-sm text-ink-muted/80 dark:text-dark-muted/80 mb-2">
                You have finished all monographs in this curriculum.
              </p>
              <div>
                <a 
                  href={path('/commonplace')} 
                  data-astro-prefetch="hover"
                  class="inline-flex items-center gap-1 text-xs font-ui font-medium text-ink-muted hover:text-ink dark:text-dark-muted dark:hover:text-dark-ink underline underline-offset-4 transition-colors"
                >
                  Review The Commonplace Book &rarr;
                </a>
              </div>
            </div>
          )}
        </div>
      </footer>

    </main>

    <!-- RIGHT SIDEBAR: High-Density Highlights & Notes Drawer -->
    <aside 
      id="right-sidebar"
      class="sidebar-drawer shrink-0 border-l border-ink-border/80 dark:border-dark-border bg-paper-100/95 dark:bg-dark-bg/95 backdrop-blur-md sticky overflow-y-auto overflow-x-hidden p-5 sm:p-6"
    >
      <div class="w-60 min-w-[15rem]">
        <!-- Header: Title + Count Badge + Filter Tabs -->
        <div class="mb-4 pb-2.5 border-b border-ink-border/60 dark:border-dark-border/60 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] uppercase tracking-widest text-ink dark:text-dark-ink font-semibold">
              Highlights
            </span>
            <span id="sidebar-count" class="font-mono text-[11px] px-1.5 py-0.5 rounded-2xs bg-paper-200/60 dark:bg-dark-border/60 text-ink dark:text-dark-ink border border-ink-border/60 dark:border-dark-border/60">
              0
            </span>
          </div>

          <!-- Filter Segmented Tabs (All vs With Notes) -->
          <div class="grid grid-cols-2 gap-1 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60" role="tablist" aria-label="Highlight filters">
            <button
              id="sidebar-filter-all"
              role="tab"
              aria-selected="true"
              class="sidebar-filter-btn py-1 px-2 rounded-xs text-center font-ui text-[11px] transition-colors duration-150 cursor-pointer bg-white dark:bg-dark-card text-ink dark:text-dark-ink font-medium border border-ink-border/80 dark:border-dark-border shadow-2xs"
            >
              All
            </button>
            <button
              id="sidebar-filter-notes"
              role="tab"
              aria-selected="false"
              class="sidebar-filter-btn py-1 px-2 rounded-xs text-center font-ui text-[11px] transition-colors duration-150 cursor-pointer text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink border border-transparent"
            >
              Notes
            </button>
          </div>
        </div>

        <!-- Highlights list populated by JS (High Density) -->
        <div id="sidebar-highlights-list" class="space-y-2.5">
          <!-- Populated dynamically -->
        </div>
      </div>
    </aside>

  </div>

  <!-- 4. FLOATING ACTION POPOVER (Compact, High-Speed Annotation Bar) -->
  <div 
    id="selection-popover"
    class="hidden fixed z-50 bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border shadow-lg shadow-black/5 dark:shadow-black/40 rounded-xs py-1 px-1.5 flex items-center gap-1 text-xs font-ui"
  >
    <!-- Primary Instant Highlight Button -->
    <button 
      type="button"
      id="popover-hl-btn"
      title="Highlight selection"
      aria-label="Highlight selection"
      class="w-8 h-8 rounded-xs hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink flex items-center justify-center transition-colors cursor-pointer select-none"
    >
      <span id="popover-hl-icon" class="flex items-center pointer-events-none">
        <svg class="w-4 h-4 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 11-6 6v3h9l3-3"/>
          <path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/>
        </svg>
      </span>
      <span id="popover-hl-label" class="sr-only">Highlight</span>
    </button>

    <span class="w-px h-4 bg-ink-border/60 dark:bg-dark-border/60 mx-0.5" aria-hidden="true"></span>

    <!-- Note & Copy Buttons -->
    <button 
      type="button"
      id="popover-note-btn"
      class="w-8 h-8 rounded-xs hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink flex items-center justify-center transition-colors cursor-pointer select-none"
      title="Add or Edit Sidenote"
      aria-label="Add or edit sidenote"
    >
      <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
      </svg>
    </button>
    <button 
      type="button"
      id="popover-copy-btn"
      class="w-8 h-8 rounded-xs hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink flex items-center justify-center transition-colors cursor-pointer select-none"
      title="Copy Quote with Citation"
      aria-label="Copy quote with citation"
    >
      <span id="popover-copy-icon" class="flex items-center pointer-events-none">
        <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
        </svg>
      </span>
      <span id="popover-copy-label" class="sr-only">Copy</span>
    </button>
  </div>

  <!-- 5. INLINE NOTE MODAL INPUT -->
  <div 
    id="note-dialog"
    class="hidden fixed inset-0 z-50 bg-ink/20 dark:bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
  >
    <div class="w-full max-w-md bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border p-5 rounded-xs shadow-xl space-y-3">
      <div class="flex items-center justify-between">
        <div class="font-serif text-base font-medium text-ink dark:text-dark-ink flex items-center gap-2">
          <svg class="w-4 h-4 text-ink-muted dark:text-dark-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>
          </svg>
          Record Sidenote / Marginalia
        </div>
        <button id="close-note-dialog-btn" class="p-1 rounded-xs text-ink-faint dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink transition-colors cursor-pointer" aria-label="Close dialog">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <p id="note-quote-preview" class="font-serif text-xs text-ink-muted dark:text-dark-muted italic line-clamp-2 border-l border-ink dark:border-dark-ink pl-2"></p>
      <textarea 
        id="note-input-text"
        rows="4"
        placeholder="Write your observation, question, or synthesis..."
        class="w-full p-2.5 text-xs font-sans rounded-xs border border-ink-border dark:border-dark-border bg-paper-100 dark:bg-dark-bg text-ink dark:text-dark-ink placeholder:text-ink-faint dark:placeholder:text-dark-muted focus:outline-hidden resize-none"
      ></textarea>
      <div class="flex items-center justify-between gap-2 pt-1">
        <span class="text-[10px] font-mono text-ink-faint dark:text-dark-muted">Esc to cancel · Ctrl+Enter to save</span>
        <div class="flex items-center gap-2">
          <button id="cancel-note-btn" class="px-3 py-1.5 text-xs font-ui text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink cursor-pointer transition-colors">Cancel</button>
          <button id="save-note-btn" class="px-3.5 py-1.5 text-xs font-ui font-medium rounded-xs bg-paper-200/90 hover:bg-paper-200 dark:bg-dark-border/80 dark:hover:bg-dark-border text-ink dark:text-dark-ink border border-ink-border/80 dark:border-dark-border cursor-pointer transition-colors">Save Sidenote</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 6. IMAGE LIGHTBOX (Floating lesson-figure viewer with zoom and pan) -->
  <div
    id="image-lightbox"
    class="hidden fixed inset-0 z-50 bg-ink/20 dark:bg-black/60 backdrop-blur-xs flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged lesson figure viewer"
  >
    <div class="w-full max-w-5xl max-h-[92vh] flex flex-col bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border rounded-xs shadow-xl overflow-hidden">
      <!-- Top bar: position counter, original link, close -->
      <div class="flex items-center justify-between gap-3 px-3 py-2 border-b border-ink-border/60 dark:border-dark-border/60">
        <span id="lightbox-counter" class="font-mono text-[11px] text-ink-muted dark:text-dark-muted shrink-0">1 / 1</span>
        <div class="flex items-center gap-2 shrink-0">
          <a
            id="lightbox-original-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-surface hover:bg-paper-100 dark:hover:bg-dark-border/40 text-ink dark:text-dark-ink font-ui text-[11px] font-medium transition-colors"
            title="Open original image in a new tab"
          >
            <span>Original</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10"/>
            </svg>
          </a>
          <button
            id="lightbox-close-btn"
            type="button"
            class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors cursor-pointer"
            title="Close viewer [ Esc ]"
            aria-label="Close viewer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Viewport: zoomable figure surface -->
      <div
        id="lightbox-viewport"
        class="relative overflow-hidden bg-paper-100 dark:bg-dark-bg touch-none select-none flex items-center justify-center h-[58vh] sm:h-[66vh] cursor-grab"
      >
        <img
          id="lightbox-image"
          src=""
          alt="Enlarged lesson figure"
          draggable="false"
          class="max-w-full max-h-full object-contain pointer-events-none"
        />
        <button
          id="lightbox-prev-btn"
          type="button"
          class="absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-white/90 dark:bg-dark-card/90 hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors cursor-pointer"
          title="Previous figure"
          aria-label="Previous figure"
        >
          <svg class="w-4 h-4 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <button
          id="lightbox-next-btn"
          type="button"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-white/90 dark:bg-dark-card/90 hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors cursor-pointer"
          title="Next figure"
          aria-label="Next figure"
        >
          <svg class="w-4 h-4 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>

      <!-- Footer: caption plus zoom controls -->
      <div class="px-3 py-2.5 border-t border-ink-border/60 dark:border-dark-border/60 space-y-2">
        <p id="lightbox-caption" class="font-sans text-xs text-ink-muted dark:text-dark-muted text-center leading-relaxed line-clamp-2 min-h-[1rem]"></p>
        <div class="flex items-center justify-center gap-1.5">
          <button
            id="lightbox-zoom-out-btn"
            type="button"
            class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors cursor-pointer"
            title="Zoom out [ - ]"
            aria-label="Zoom out"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 12h14"/>
            </svg>
          </button>
          <button
            id="lightbox-zoom-reset-btn"
            type="button"
            class="min-w-[3.5rem] h-8 px-2 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink font-mono text-xs transition-colors cursor-pointer"
            title="Reset zoom [ 0 ]"
          >
            <span id="lightbox-zoom-label">100%</span>
          </button>
          <button
            id="lightbox-zoom-in-btn"
            type="button"
            class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors cursor-pointer"
            title="Zoom in [ + ]"
            aria-label="Zoom in"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. EXPLORED HIGHLIGHT REMINDER TOAST -->
  <div 
    id="explored-reminder-toast" 
    class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-white dark:bg-dark-card border border-ink-border dark:border-dark-border shadow-lg shadow-black/5 dark:shadow-black/40 rounded-xs py-2 px-3.5 flex items-center gap-3 text-xs font-sans pointer-events-auto transition-opacity duration-300"
    role="status"
    aria-live="polite"
  >
    <span class="w-1.5 h-1.5 rounded-full bg-purple-600 dark:bg-purple-400 shrink-0"></span>
    <span class="text-ink dark:text-dark-ink">Highlight saved. Note: You haven't started reading this lesson yet.</span>
    <button 
      id="toast-start-reading-btn" 
      type="button" 
      class="font-ui text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline cursor-pointer ml-1"
    >
      Start Reading
    </button>
  </div>
</BaseLayout>

<!-- CLIENT SCRIPT: boot call only (ADR-027). Library loads once from /scripts/reader.js; per-page vars ride on #study-desk data-* and re-boot on every ClientRouter navigation. -->
  <script is:inline>
    (function () {
      try {
        var desk = document.getElementById('study-desk');
        if (desk && window.__ahkhBootReader) window.__ahkhBootReader(Object.assign({}, desk.dataset));
      } catch (e) {}
    })();
  </script>

