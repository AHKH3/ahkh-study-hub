---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COURSES } from '../../../data/courses';
import TRANSCRIPTS from '../../../data/transcripts.json';
import { path } from '../../../utils/paths';
import { getFormatColor } from '../../../utils/categoryColors';
import { PanelLeft, PanelRight, ChevronLeft, Sun, Moon, RotateCcw } from '@lucide/astro';

export function getStaticPaths() {
  const paths: any[] = [];
  COURSES.forEach((course) => {
    const allLessons: any[] = [];
    course.modules.forEach((mod) => {
      mod.lessons.forEach((lesson) => {
        allLessons.push(lesson);
      });
    });

    allLessons.forEach((lesson, index) => {
      const prevLesson = index > 0 ? {
        slug: allLessons[index - 1].slug,
        title: allLessons[index - 1].title,
        lessonNumber: allLessons[index - 1].lessonNumber,
        type: allLessons[index - 1].type,
        readTime: allLessons[index - 1].readTime,
      } : null;
      const nextLesson = index < allLessons.length - 1 ? {
        slug: allLessons[index + 1].slug,
        title: allLessons[index + 1].title,
        lessonNumber: allLessons[index + 1].lessonNumber,
        type: allLessons[index + 1].type,
        readTime: allLessons[index + 1].readTime,
      } : null;

      paths.push({
        params: { course: course.slug, slug: lesson.slug },
        props: { course, lesson, prevLesson, nextLesson },
      });
    });
  });
  return paths;
}

const { course, lesson, prevLesson, nextLesson } = Astro.props;
// Auto-ingested verbatim cues for this video (if any), baked at build time by scripts/fetch-transcripts.mjs
const transcriptSegments =
  lesson.youtubeId && TRANSCRIPTS[lesson.youtubeId]?.segments?.length
    ? TRANSCRIPTS[lesson.youtubeId].segments
    : null;
---

<BaseLayout title={`${lesson.title} — ${course.title}`} description={lesson.summaryQuote}>
  <!-- 1. PERMANENT TOP PROGRESS BAR (top: 0, 3px, never disappears) -->
  <div id="top-progress-track" class="fixed top-0 left-0 w-full h-[3px] bg-paper-300 dark:bg-dark-border z-50">
    <div 
      id="top-progress-fill" 
      class="h-full transition-all duration-100 ease-out"
      style={`background-color: ${course.theme.accent}; width: 0%;`}
    ></div>
  </div>

  <!-- 2. SMART AUTO-HIDING HEADER -->
  <header 
    id="smart-header" 
    class="fixed top-[3px] left-0 w-full h-14 z-40 bg-paper-100/95 dark:bg-dark-bg/95 backdrop-blur-md border-b border-ink-border/80 dark:border-dark-border transition-transform duration-300 ease-in-out box-border"
  >
    <div class="w-full px-4 sm:px-6 h-full flex items-center justify-between gap-4">
      
      <!-- Left Controls: Back Arrow + Left Sidebar Toggle Icon -->
      <div class="flex items-center gap-2 shrink-0">
        <a 
          href={path(`/courses/${course.slug}`)} 
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 flex items-center justify-center text-ink dark:text-dark-ink transition-colors cursor-pointer"
          title="Return to Course Journey"
          aria-label="Return to Course Journey"
        >
          <ChevronLeft class="w-4 h-4" />
        </a>

        <button 
          id="toggle-left-sidebar"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-all active:scale-95 duration-150 cursor-pointer"
          title="Toggle Document Outline (Left Sidebar) [ [ ]"
          aria-label="Toggle Document Outline"
        >
          <PanelLeft class="w-4 h-4" />
        </button>
      </div>

      <!-- Center Title -->
      <div class="flex-1 text-center min-w-0 px-2">
        <div class="flex items-center justify-center gap-2">
          <span class="font-mono text-xs text-ink-muted dark:text-dark-muted shrink-0">{lesson.lessonNumber}</span>
          <h1 class="font-serif text-sm sm:text-base font-semibold text-ink dark:text-dark-ink truncate">
            {lesson.title}
          </h1>
        </div>
      </div>

      <!-- Right Controls: Display Settings + Zen Mode + Highlights Drawer Toggle -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Display Settings Button (Aa) -->
        <button 
          id="toggle-display-settings"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink text-xs font-ui font-semibold flex items-center justify-center transition-all active:scale-95 duration-150 cursor-pointer"
          title="Reading & Typography Settings"
          aria-label="Reading & Typography Settings"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Aa
        </button>

        <!-- Zen Mode Button (Maximize Canvas) -->
        <button 
          id="toggle-zen-mode"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hidden md:flex items-center justify-center transition-all active:scale-95 duration-150 cursor-pointer"
          title="Toggle Zen Focus Mode [ Z ]"
          aria-label="Toggle Zen Focus Mode"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
        </button>

        <!-- Right Highlights Sidebar Toggle Icon Button -->
        <button 
          id="toggle-right-sidebar"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-all active:scale-95 duration-150 cursor-pointer relative"
          title="Toggle Highlights & Marginalia (Right Sidebar) [ ] ]"
          aria-label="Toggle Highlights & Marginalia"
        >
          <PanelRight class="w-4 h-4" />
          <span 
            id="header-highlights-count" 
            class="absolute -top-1 -right-1 font-mono text-[10px] min-w-[15px] h-[15px] px-1 rounded-full bg-paper-200 text-ink dark:bg-dark-border dark:text-dark-ink border border-ink-border/80 dark:border-dark-border flex items-center justify-center transition-all hidden scale-90 font-medium"
          >
            0
          </span>
        </button>
      </div>

    </div>
  </header>

  <!-- DISPLAY SETTINGS POPOVER (Swiss Editorial Comfort) -->
  <div 
    id="display-settings-menu"
    role="dialog"
    aria-label="Reading Typography and Comfort Settings"
    class="hidden fixed top-16 right-4 sm:right-6 w-80 sm:w-84 max-h-[88vh] overflow-y-auto p-4 sm:p-5 rounded-xs border border-ink-border dark:border-dark-border/80 bg-paper-50/98 dark:bg-dark-card/98 backdrop-blur-xl shadow-2xl shadow-ink/5 dark:shadow-black/80 ring-1 ring-ink/5 dark:ring-white/5 z-50 text-xs font-sans space-y-5 text-ink dark:text-dark-ink"
  >
    <!-- Header: Title + Reset -->
    <div class="flex items-center justify-between pb-2 border-b border-ink-border/60 dark:border-dark-border/60">
      <span class="font-mono uppercase tracking-widest text-[10px] text-ink-muted dark:text-dark-muted font-medium">Display & Comfort</span>
      <button 
        id="reset-display-btn" 
        class="text-[11px] font-ui text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center gap-1 transition-colors cursor-pointer"
        title="Reset typography settings to default"
      >
        <RotateCcw class="w-3 h-3" />
        <span>Reset</span>
      </button>
    </div>
    
    <!-- 1. Font Size Control -->
    <div>
      <div class="flex items-center justify-between text-ink-muted dark:text-dark-muted mb-2">
        <span class="font-medium text-[11px]">Type Size</span>
        <span id="font-size-label" class="font-mono text-[10px] text-ink dark:text-dark-ink">Standard (18px)</span>
      </div>
      <div class="grid grid-cols-4 gap-1 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
        <button data-size="sm" class="size-btn py-1.5 px-2 rounded-xs text-center font-ui transition-all cursor-pointer" title="Small (16px)">
          <span class="text-xs">A</span>
        </button>
        <button data-size="base" class="size-btn py-1.5 px-2 rounded-xs text-center font-ui transition-all cursor-pointer" title="Standard (18px)">
          <span class="text-sm">A</span>
        </button>
        <button data-size="lg" class="size-btn py-1.5 px-2 rounded-xs text-center font-ui transition-all cursor-pointer" title="Large (21px)">
          <span class="text-base font-medium">A</span>
        </button>
        <button data-size="xl" class="size-btn py-1.5 px-2 rounded-xs text-center font-ui transition-all cursor-pointer" title="Expanded (24px)">
          <span class="text-lg font-bold">A</span>
        </button>
      </div>
    </div>

    <!-- 2. Typeface Family (Unified 7-Typeface Selector) -->
    <div>
      <div class="flex items-center justify-between text-ink dark:text-dark-ink mb-2">
        <span class="font-medium text-[11px]">Reading Typeface</span>
        <span id="font-family-label" class="font-mono text-[10px] font-semibold text-ink dark:text-dark-ink">Merriweather</span>
      </div>
      
      <div class="space-y-1 p-1 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60 max-h-56 overflow-y-auto">
        <button 
          data-font-id="merriweather" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Merriweather', Georgia, serif;"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Merriweather</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Serif (Default)</span>
        </button>

        <button 
          data-font-id="source-serif" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Source Serif 4', Georgia, serif;"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Source Serif 4</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Book Serif</span>
        </button>
        
        <button 
          data-font-id="literata" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Literata', Georgia, serif;"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Literata</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Digital Reading</span>
        </button>
        
        <button 
          data-font-id="lora" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Lora', Georgia, serif;"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Lora</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Contemporary</span>
        </button>
        
        <button 
          data-font-id="newsreader" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Newsreader', Georgia, serif;"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Newsreader</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Classic Literary</span>
        </button>

        <button 
          data-font-id="geist" 
          class="font-family-btn w-full py-2 px-3 rounded-xs text-left transition-all cursor-pointer flex items-center justify-between"
          style="font-family: 'Geist', sans-serif; /* impeccable-disable-line overused-font -- preview option */"
        >
          <span class="text-sm font-medium text-ink dark:text-dark-ink">Geist Sans</span>
          <span class="text-[10px] font-mono font-medium text-ink/75 dark:text-dark-ink/75">Clean Minimalist</span>
        </button>
      </div>
    </div>

    <!-- 3. Reading Measure -->
    <div>
      <div class="flex items-center justify-between text-ink dark:text-dark-ink mb-2">
        <span class="font-medium text-[11px]">Reading Measure</span>
        <span id="measure-label" class="font-mono text-[10px] font-semibold text-ink dark:text-dark-ink">Standard (68ch)</span>
      </div>
      <div class="grid grid-cols-2 gap-1.5 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
        <button id="measure-standard-btn" class="measure-btn py-1.5 px-2 rounded-xs text-center font-ui text-xs transition-all cursor-pointer">
          Standard (68ch)
        </button>
        <button id="measure-wide-btn" class="measure-btn py-1.5 px-2 rounded-xs text-center font-ui text-xs transition-all cursor-pointer">
          Expanded (82ch)
        </button>
      </div>
    </div>

    <!-- 4. Reading Surface Palette -->
    <div class="pt-3 border-t border-ink-border/60 dark:border-dark-border/60">
      <div class="flex items-center justify-between mb-2">
        <span class="font-medium text-[11px] text-ink-muted dark:text-dark-muted">Surface Palette</span>
        <span id="theme-status-label" class="font-mono text-[10px] text-ink dark:text-dark-ink">Light</span>
      </div>
      <div class="grid grid-cols-2 gap-1.5 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
        <button id="theme-light-btn" class="theme-switch-btn py-1.5 px-2.5 rounded-xs text-center font-ui text-xs transition-all cursor-pointer flex items-center justify-center gap-1.5">
          <Sun class="w-3.5 h-3.5" />
          <span>Light</span>
        </button>
        <button id="theme-dark-btn" class="theme-switch-btn py-1.5 px-2.5 rounded-xs text-center font-ui text-xs transition-all cursor-pointer flex items-center justify-center gap-1.5">
          <Moon class="w-3.5 h-3.5" />
          <span>Dark</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MOBILE SIDEBAR BACKDROP OVERLAY -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-ink/20 dark:bg-black/60 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

  <!-- 3. THE 3-COLUMN STUDY DESK -->
  <div id="study-desk" class="flex-1 w-full pt-[59px] flex relative overflow-x-clip min-h-screen">
    
    <!-- LEFT SIDEBAR: Outline / TOC Only -->
    <aside 
      id="left-sidebar"
      class="sidebar-drawer shrink-0 border-r border-ink-border/80 dark:border-dark-border bg-paper-100/95 dark:bg-dark-bg/95 backdrop-blur-md sticky overflow-y-auto overflow-x-hidden p-6"
    >
      <div class="w-52 min-w-[13rem]">
        <!-- Study Mode & Reading Status Card -->
        <div id="sidebar-study-card" class="mb-5 pb-4 border-b border-ink-border/60 dark:border-dark-border">
          <div class="flex items-center justify-between gap-2 mb-2.5">
            <span class="font-mono text-[10px] uppercase tracking-widest text-ink-muted dark:text-dark-muted font-semibold">Reading State</span>
            <span id="lesson-status-badge" class="inline-flex items-center gap-1.5 font-mono text-[11px] font-medium tracking-widest text-purple-700 dark:text-purple-400">
              <span id="lesson-status-dot" class="w-1.5 h-1.5 rounded-full bg-purple-600 dark:bg-purple-400"></span>
              <span id="lesson-status-text">Exploring</span>
            </span>
          </div>

          <!-- Start Reading Action Button (shown in Exploring state) -->
          <button
            type="button"
            id="start-reading-btn"
            class="w-full font-ui text-xs font-medium py-1.5 px-2.5 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink dark:text-dark-ink transition-colors cursor-pointer flex items-center justify-center gap-1.5 shadow-2xs"
          >
            <svg class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            <span>Start Reading</span>
          </button>

          <!-- Reading Timestamp (shown when reading or completed) -->
          <div id="reading-timestamp-display" class="hidden font-mono text-[11px] text-ink-muted dark:text-dark-muted flex items-center justify-center gap-1.5 py-1">
            <svg class="w-3 h-3 text-amber-600 dark:text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span id="reading-timestamp-text"></span>
          </div>
        </div>

        <div class="font-mono text-[11px] uppercase tracking-widest text-ink dark:text-dark-ink font-semibold mb-4 pb-2 border-b border-ink-border/60 dark:border-dark-border/60">
          Document Outline
        </div>
        <nav class="space-y-2 text-xs font-sans">
          {lesson.outline.map((item) => (
            <a 
              href={`#${item.id}`}
              class:list={[
                "block text-ink/70 dark:text-dark-ink/70 hover:text-ink dark:hover:text-dark-ink transition-all duration-200 line-clamp-1 py-1.5 px-2 hover:bg-paper-100 dark:hover:bg-dark-surface border-l-[2px] border-transparent hover:border-ink-muted dark:hover:border-dark-muted",
                item.level === 3 ? "ml-3 text-[11px]" : "font-medium"
              ]}
            >
              {item.title}
            </a>
          ))}
        </nav>

        <div class="mt-8 pt-4 border-t border-ink-border/60 dark:border-dark-border/60">
          <div class="font-mono text-[10px] text-ink/75 dark:text-dark-ink/75 font-semibold mb-1">Source Information</div>
          <a 
            href={lesson.originalSourceUrl || "#"} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[11px] text-ink dark:text-dark-ink hover:underline line-clamp-1 font-sans flex items-center gap-1"
          >
            {lesson.originalSourceLabel || "Original Material"} ↗
          </a>
        </div>
      </div>
    </aside>

    <!-- CENTER: Reading Sanctuary Canvas -->
    <main id="center-reading-column" class="flex-1 px-6 sm:px-12 py-10 max-w-reading mx-auto relative">
      
      <!-- Article Heading Block -->
      <div class="mb-10 pb-6 border-b border-ink-border/80 dark:border-dark-border">
        <div class="flex items-center gap-2 font-mono text-xs text-ink/80 dark:text-dark-ink/80 mb-2 font-medium">
          <span>Unit {lesson.unitNumber}</span>
          <span>·</span>
          <span>Lesson {lesson.lessonNumber}</span>
          <span>·</span>
          <span class={`font-medium ${getFormatColor(lesson.type)}`}>{lesson.type === 'video' ? 'Video' : lesson.type === 'pdf' ? 'PDF' : 'Article'}</span>
          <span>·</span>
          <span>{lesson.readTime} read</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-ink dark:text-dark-ink mb-5">
          {lesson.title}
        </h1>

        <p class="font-serif text-base sm:text-lg lg:text-xl text-ink/85 dark:text-dark-ink/85 italic leading-relaxed border-l-[3px] border-ink-border dark:border-dark-border pl-5 py-1">
          "{lesson.summaryQuote}"
        </p>
      </div>

      <!-- VIDEO PLAYER IF TYPE == VIDEO -->
      {lesson.type === 'video' && lesson.youtubeId && (
        <>
          <div id="video-scroll-sentinel" class="w-full h-px -mt-px pointer-events-none opacity-0" aria-hidden="true"></div>
          <div id="video-sticky-wrapper" class="video-sticky-wrapper mb-10 transition-all duration-300">
            <div class="video-player-card rounded-xs overflow-hidden border border-ink-border dark:border-dark-border bg-ink shadow-sm transition-all duration-300">
              <div class="video-aspect-box aspect-video w-full bg-ink transition-all duration-300">
                <iframe 
                  id="youtube-player"
                  class="w-full h-full"
                  src={`https://www.youtube-nocookie.com/embed/${lesson.youtubeId}?enablejsapi=1&rel=0&modestbranding=1&playsinline=1`}
                  title={`Video lecture: ${lesson.title}`}
                  loading="lazy"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="p-2.5 bg-paper-200/90 dark:bg-dark-card border-t border-ink-border dark:border-dark-border flex flex-wrap items-center justify-between gap-3 text-xs font-sans">
                <span class="text-ink-muted dark:text-dark-muted flex items-center gap-1.5 font-medium">
                  <span class="w-2 h-2 rounded-full bg-rose-600 dark:bg-rose-400"></span>
                  <span>Video Lecture & Synced Transcript</span>
                </span>
                <div class="flex items-center gap-2.5">
                  <label class="flex items-center gap-1.5 cursor-pointer text-ink dark:text-dark-ink font-medium select-none text-[11px] sm:text-xs">
                    <input type="checkbox" id="auto-scroll-sync" checked class="rounded-xs text-ink accent-rose-600 cursor-pointer" />
                    <span>Auto-Scroll</span>
                  </label>
                  <div class="h-3.5 w-px bg-ink-border dark:bg-dark-border hidden sm:block"></div>
                  <button 
                    type="button" 
                    id="toggle-video-pin" 
                    class="font-ui text-[11px] sm:text-xs flex items-center gap-1 px-2 py-1 rounded-xs border border-ink-border/80 dark:border-dark-border text-ink dark:text-dark-ink bg-paper-50 dark:bg-dark-surface hover:bg-paper-100 dark:hover:bg-dark-border/40 transition-colors cursor-pointer select-none"
                    title="Toggle sticky video player when scrolling"
                    aria-pressed="true"
                  >
                    <svg class="w-3 h-3 text-rose-600 dark:text-rose-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="12" y1="17" x2="12" y2="22"/>
                      <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/>
                    </svg>
                    <span id="video-pin-label">Pinned</span>
                  </button>
                  <button 
                    type="button" 
                    id="toggle-video-compact" 
