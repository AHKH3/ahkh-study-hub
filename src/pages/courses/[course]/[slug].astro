---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllSyllabi, getLesson, getTranscript } from '../../../data/loader';
import type { CourseShellToken, LessonNavLink } from '../../../data/types';
import { path } from '../../../utils/paths';
import { getFormatColor } from '../../../utils/categoryColors';
import { PanelLeft, PanelRight, ChevronLeft, Sun, Moon, RotateCcw } from '@lucide/astro';

export function getStaticPaths() {
  const syllabi = getAllSyllabi();
  const paths: any[] = [];
  syllabi.forEach((course) => {
    const courseShell: CourseShellToken = {
      id: course.id,
      slug: course.slug,
      title: course.title,
      theme: {
        accent: course.theme?.accent || '#18181B',
        highlight: course.theme?.highlight || 'rgba(0, 0, 0, 0.08)',
      },
    };

    const allLessons = course.modules.flatMap((mod) => mod.lessons);

    allLessons.forEach((summary, index) => {
      const prevLesson: LessonNavLink | null = index > 0 ? {
        slug: allLessons[index - 1].slug,
        title: allLessons[index - 1].title,
        lessonNumber: allLessons[index - 1].lessonNumber,
        type: allLessons[index - 1].type,
        readTime: allLessons[index - 1].readTime,
      } : null;
      const nextLesson: LessonNavLink | null = index < allLessons.length - 1 ? {
        slug: allLessons[index + 1].slug,
        title: allLessons[index + 1].title,
        lessonNumber: allLessons[index + 1].lessonNumber,
        type: allLessons[index + 1].type,
        readTime: allLessons[index + 1].readTime,
      } : null;

      paths.push({
        params: { course: course.slug, slug: summary.slug },
        props: { course: courseShell, prevLesson, nextLesson },
      });
    });
  });
  return paths;
}

const { course, prevLesson, nextLesson } = Astro.props;
const { course: courseSlug, slug: lessonSlug } = Astro.params;

const lesson = await getLesson(courseSlug!, lessonSlug!);
if (!lesson) {
  return Astro.redirect(path('/404'));
}

// Auto-ingested verbatim cues for this video (if any), loaded on demand from individual JSON files
const transcriptSegments = lesson.youtubeId ? await getTranscript(lesson.youtubeId) : null;
---

<BaseLayout title={`${lesson.title} — ${course.title}`} description={lesson.summaryQuote} readerLib>
  <!-- 1. PERMANENT TOP PROGRESS BAR (top: 0, 3px, never disappears) -->
  <div id="top-progress-track" class="fixed top-0 left-0 w-full h-[3px] bg-paper-300 dark:bg-dark-border z-50">
    <div 
      id="top-progress-fill" 
      class="h-full transition-[width] duration-150 ease-out"
      style={`background-color: ${course.theme.accent}; width: 0%;`}
    ></div>
  </div>

  <!-- 2. SMART AUTO-HIDING HEADER -->
  <header 
    id="smart-header" 
    class="fixed top-[3px] left-0 w-full h-14 z-30 bg-paper-100/95 dark:bg-dark-bg/95 backdrop-blur-md border-b border-ink-border/80 dark:border-dark-border transition-transform duration-300 ease-out box-border"
  >
    <div class="w-full px-4 sm:px-6 h-full flex items-center justify-between gap-4">
      
      <!-- Left Controls: Back Arrow + Left Sidebar Toggle Icon -->
      <div class="flex items-center gap-2 shrink-0">
        <a 
          href={path(`/courses/${course.slug}`)} 
          data-astro-prefetch="hover"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 flex items-center justify-center text-ink dark:text-dark-ink transition-colors cursor-pointer"
          title="Return to Course Journey"
          aria-label="Return to Course Journey"
        >
          <ChevronLeft class="w-4 h-4" />
        </a>

        <button 
          id="toggle-left-sidebar"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors duration-150 active:scale-95 cursor-pointer"
          title="Toggle Document Outline (Left Sidebar) [ [ ]"
          aria-label="Toggle Document Outline"
        >
          <PanelLeft class="w-4 h-4" />
        </button>
      </div>

      <!-- Center Title (revealed only after the hero title scrolls out of view) -->
      <div id="smart-header-title" class="flex-1 text-center min-w-0 px-2 opacity-0 transition-opacity duration-150 ease-out" aria-hidden="true">
        <div class="flex items-center justify-center gap-2">
          <span class="font-mono text-xs text-ink-muted dark:text-dark-muted shrink-0">{lesson.lessonNumber}</span>
          <h1 class="font-serif text-sm sm:text-base font-semibold text-ink dark:text-dark-ink truncate">
            {lesson.title}
          </h1>
        </div>
      </div>

      <!-- Right Controls: Display Settings + Zen Mode + Highlights Drawer Toggle -->
      <div class="flex items-center gap-2 shrink-0">
        <!-- Display Settings Button (Aa) -->
        <button 
          id="toggle-display-settings"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink text-xs font-ui font-semibold flex items-center justify-center transition-colors duration-150 active:scale-95 cursor-pointer"
          title="Reading & Typography Settings"
          aria-label="Reading & Typography Settings"
          aria-expanded="false"
          aria-haspopup="true"
        >
          Aa
        </button>

        <!-- Zen Mode Button (Maximize Canvas) -->
        <button 
          id="toggle-zen-mode"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink hidden md:flex items-center justify-center transition-colors duration-150 active:scale-95 cursor-pointer"
          title="Toggle Zen Focus Mode [ Z ]"
          aria-label="Toggle Zen Focus Mode"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
          </svg>
        </button>

        <!-- Right Highlights Sidebar Toggle Icon Button -->
        <button 
          id="toggle-right-sidebar"
          class="w-8 h-8 rounded-xs border border-ink-border dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:bg-paper-200 dark:hover:bg-dark-border/60 text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center justify-center transition-colors duration-150 active:scale-95 cursor-pointer relative"
          title="Toggle Highlights & Marginalia (Right Sidebar) [ ] ]"
          aria-label="Toggle Highlights & Marginalia"
        >
          <PanelRight class="w-4 h-4" />
          <span 
            id="header-highlights-count" 
            class="absolute -top-1 -right-1 font-mono text-[10px] min-w-[15px] h-[15px] px-1 rounded-full bg-paper-200 text-ink dark:bg-dark-border dark:text-dark-ink border border-ink-border/80 dark:border-dark-border flex items-center justify-center transition-colors duration-150 hidden scale-90 font-medium"
          >
            0
          </span>
        </button>
      </div>

    </div>
  </header>

  <!-- DISPLAY SETTINGS POPOVER (Swiss Editorial Comfort) -->
  <!-- DISPLAY SETTINGS POPOVER (Swiss Editorial Precision & Annotation Controls) -->
  <div 
    id="display-settings-menu"
    role="dialog"
    aria-label="Reading Typography and Comfort Settings"
    class="hidden fixed top-16 right-4 sm:right-6 w-80 sm:w-84 max-h-[88vh] overflow-y-auto p-4 sm:p-5 rounded-xs border border-ink-border dark:border-dark-border/80 bg-paper-50/98 dark:bg-dark-card/98 backdrop-blur-xl shadow-2xl shadow-ink/5 dark:shadow-black/80 ring-1 ring-ink/5 dark:ring-white/5 z-50 text-xs font-sans space-y-4 text-ink dark:text-dark-ink"
  >
    <!-- Header: Title + Reset -->
    <div class="flex items-center justify-between pb-2 border-b border-ink-border/60 dark:border-dark-border/60">
      <span class="font-mono uppercase tracking-widest text-[10px] text-ink-muted dark:text-dark-muted font-medium">Display & Annotations</span>
      <button 
        id="reset-display-btn" 
        class="text-[11px] font-ui text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink flex items-center gap-1 transition-colors cursor-pointer"
        title="Reset reading & annotation settings to default"
      >
        <RotateCcw class="w-3 h-3" />
        <span>Reset</span>
      </button>
    </div>

    <!-- 1. Typeface Selector (Custom Dropdown) -->
    <div class="relative">
      <div class="flex items-center justify-between text-ink dark:text-dark-ink mb-1.5">
        <span class="font-medium text-[11px]">Reading Typeface</span>
        <span id="font-family-badge" class="font-mono text-[10px] text-ink-muted dark:text-dark-muted">Serif</span>
      </div>
      <button
        type="button"
        id="font-family-dropdown-btn"
        aria-haspopup="listbox"
        aria-expanded="false"
        class="w-full py-2 px-3 rounded-xs border border-ink-border dark:border-dark-border bg-white dark:bg-dark-bg text-ink dark:text-dark-ink hover:bg-paper-100 dark:hover:bg-dark-card transition-colors duration-150 cursor-pointer flex items-center justify-between shadow-2xs text-left"
      >
        <span id="font-family-label" class="font-serif text-sm font-medium truncate">Merriweather</span>
        <svg class="w-3.5 h-3.5 text-ink-muted dark:text-dark-muted dropdown-chevron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>

      <!-- Dropdown Menu -->
      <div
        id="font-family-dropdown-menu"
        role="listbox"
        class="hidden absolute top-full left-0 right-0 mt-1 z-30 p-1 rounded-xs border border-ink-border dark:border-dark-border bg-white dark:bg-dark-card shadow-lg space-y-0.5"
      >
        <button 
          data-font-id="merriweather" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Merriweather', Georgia, serif;"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Merriweather</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Serif (Default)</span>
        </button>
        <button 
          data-font-id="source-serif" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Source Serif 4', Georgia, serif;"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Source Serif 4</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Book Serif</span>
        </button>
        <button 
          data-font-id="literata" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Literata', Georgia, serif;"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Literata</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Digital Reading</span>
        </button>
        <button 
          data-font-id="lora" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Lora', Georgia, serif;"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Lora</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Contemporary</span>
        </button>
        <button 
          data-font-id="newsreader" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Newsreader', Georgia, serif;"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Newsreader</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Classic Literary</span>
        </button>
        <button 
          data-font-id="geist" 
          role="option"
          class="font-family-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
          style="font-family: 'Geist', sans-serif; /* impeccable-disable-line overused-font -- preview option */"
        >
          <span class="text-xs font-medium text-ink dark:text-dark-ink">Geist Sans</span>
          <span class="text-[10px] font-mono text-ink-muted dark:text-dark-muted">Clean Minimalist</span>
        </button>
      </div>
    </div>
    
    <!-- 2. Font Size & Reading Measure (Unified Typography Metrics) -->
    <div class="space-y-3 pt-2 border-t border-ink-border/60 dark:border-dark-border/60">
      <div>
        <div class="mb-1.5">
          <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Type Size</span>
        </div>
        <div class="p-2 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
          <div class="flex items-center gap-2.5 px-1">
            <span class="text-xs font-serif font-normal text-ink-muted dark:text-dark-muted shrink-0 select-none">A</span>
            <input
              type="range"
              id="font-size-slider"
              min="0"
              max="5"
              step="1"
              value="2"
              aria-label="Adjust font size"
              class="font-size-range w-full cursor-pointer"
            />
            <span class="text-base font-serif font-bold text-ink dark:text-dark-ink shrink-0 select-none">A</span>
          </div>
          <div class="flex justify-between items-end h-5 mt-2 px-1 select-none" aria-hidden="true">
            <div id="font-size-tick-0" class="w-1 bg-ink-border dark:bg-dark-border rounded-2xs transition-colors duration-150" style="height: 6px;"></div>
            <div id="font-size-tick-1" class="w-1 bg-ink-border dark:bg-dark-border rounded-2xs transition-colors duration-150" style="height: 9px;"></div>
            <div id="font-size-tick-2" class="w-1 bg-ink dark:bg-dark-ink rounded-2xs transition-colors duration-150" style="height: 12px;"></div>
            <div id="font-size-tick-3" class="w-1 bg-ink-border dark:bg-dark-border rounded-2xs transition-colors duration-150" style="height: 15px;"></div>
            <div id="font-size-tick-4" class="w-1 bg-ink-border dark:bg-dark-border rounded-2xs transition-colors duration-150" style="height: 18px;"></div>
            <div id="font-size-tick-5" class="w-1 bg-ink-border dark:bg-dark-border rounded-2xs transition-colors duration-150" style="height: 21px;"></div>
          </div>
        </div>
      </div>

      <div>
        <div class="mb-1.5">
          <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Reading Measure</span>
        </div>
        <div class="grid grid-cols-2 gap-1.5 p-0.5 rounded-xs bg-paper-200/50 dark:bg-dark-bg/80 border border-ink-border/60 dark:border-dark-border/60">
          <button id="measure-standard-btn" class="measure-btn py-1.5 px-2 rounded-xs text-center font-ui text-xs transition-colors duration-150 cursor-pointer">
            Standard
          </button>
          <button id="measure-wide-btn" class="measure-btn py-1.5 px-2 rounded-xs text-center font-ui text-xs transition-colors duration-150 cursor-pointer">
            Expanded
          </button>
        </div>
      </div>
    </div>

    <!-- 3. Highlight Style & Default Color (Annotations Mastery) -->
    <div class="space-y-3 pt-2 border-t border-ink-border/60 dark:border-dark-border/60">
      <div class="relative">
        <div class="mb-1.5">
          <span class="font-medium text-[11px] text-ink dark:text-dark-ink">Highlight Style</span>
        </div>
        <button
          type="button"
          id="hl-style-dropdown-btn"
          aria-haspopup="listbox"
          aria-expanded="false"
          class="w-full py-2 px-3 rounded-xs border border-ink-border dark:border-dark-border bg-white dark:bg-dark-bg text-ink dark:text-dark-ink hover:bg-paper-100 dark:hover:bg-dark-card transition-colors duration-150 cursor-pointer flex items-center justify-between shadow-2xs text-left"
        >
          <div class="flex items-center gap-2 truncate">
            <span id="hl-style-icon-preview" class="w-3.5 h-3.5 rounded-2xs border border-ink-border dark:border-dark-border shrink-0" style="background: rgba(217, 119, 6, 0.22); border-bottom: 2px solid #D97706;"></span>
            <span id="hl-style-label" class="font-ui text-xs font-medium truncate">Classic Tint</span>
          </div>
          <svg class="w-3.5 h-3.5 text-ink-muted dark:text-dark-muted dropdown-chevron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>

        <!-- Style Dropdown Menu -->
        <div
          id="hl-style-dropdown-menu"
          role="listbox"
          class="hidden absolute top-full left-0 right-0 mt-1 z-30 p-1 rounded-xs border border-ink-border dark:border-dark-border bg-white dark:bg-dark-card shadow-lg space-y-0.5"
        >
          <button 
            data-hl-style="tint" 
            role="option"
            class="hl-style-opt-btn w-full py-2 px-2.5 rounded-xs text-left transition-colors duration-150 cursor-pointer flex items-center justify-between"
