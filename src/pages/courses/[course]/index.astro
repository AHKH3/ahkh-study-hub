---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COURSES } from '../../../data/courses';
import { path } from '../../../utils/paths';
import { getCategoryColor, getFormatColor } from '../../../utils/categoryColors';

export function getStaticPaths() {
  return COURSES.map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
---

<BaseLayout title={`${course.title} — Learning Journey`} description={course.description}>
  <!-- Minimal Top Header for Course -->
  <header class="w-full border-b border-ink-border/80 dark:border-dark-border bg-paper-100/90 dark:bg-dark-bg/90 backdrop-blur-sm sticky top-0 z-30 transition-colors">
    <div class="max-w-hub mx-auto px-6 h-14 flex items-center justify-between">
      <a href={path('/')} class="flex items-center gap-2 text-xs font-sans font-medium text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink transition-colors group">
        <svg class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Library of Curricula
      </a>

      <div class="flex items-center gap-3">
        <span class="font-mono text-xs text-ink-muted dark:text-dark-muted">
          Progress: {course.progressPercent}%
        </span>
        <div class="w-20 h-1.5 bg-paper-300 dark:bg-dark-border rounded-full overflow-hidden">
          <div 
            class="h-full bg-ink dark:bg-dark-ink transition-all" 
            style={`width: ${course.progressPercent}%`}
          ></div>
        </div>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-hub w-full mx-auto px-6 py-12">
    <!-- Course Title & Metadata -->
    <div class="mb-14 pb-8 border-b border-ink-border/80 dark:border-dark-border">
      <div class="flex items-center gap-2.5 mb-2.5">
        <span class={`text-xs font-mono tracking-wider uppercase font-medium ${getCategoryColor(course.category)}`}>
          {course.category}
        </span>
        <span class="font-mono text-xs text-ink-muted/80 dark:text-dark-muted/80">
          · <span class="font-medium text-ink dark:text-dark-ink">{course.totalModules}</span> Modules · <span class="font-medium text-ink dark:text-dark-ink">{course.totalSources}</span> Total Sources
        </span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-medium tracking-tight text-ink dark:text-dark-ink">
        {course.title}
      </h1>
    </div>

    <!-- The Vertical Learning Journey / Units -->
    <div class="max-w-2xl mx-auto">
      {course.modules.length === 0 ? (
        <div class="py-16 text-center border border-dashed border-ink-border dark:border-dark-border rounded-xs">
          <p class="font-serif text-lg text-ink dark:text-dark-ink">Module Roadmap is being structured</p>
          <p class="text-xs font-sans text-ink-muted dark:text-dark-muted mt-1">Check back as sources are integrated into this track.</p>
        </div>
      ) : (
        <div class="relative pl-6 sm:pl-8 space-y-12">
          <!-- Continuous Vertical Spine Line -->
          <div class="absolute left-[11px] sm:left-[13px] top-3 bottom-3 w-px bg-ink-border dark:bg-dark-border"></div>

          {course.modules.map((mod) => (
            <div class="relative">
              <!-- Module Milestone Header (Node on spine) -->
              <div class="flex items-start gap-3 sm:gap-4 -ml-6 sm:-ml-8 mb-6">
                <div class="w-6 h-6 sm:w-7 sm:h-7 rounded-full border border-ink dark:border-dark-ink bg-paper-100 dark:bg-dark-card flex items-center justify-center font-mono text-xs font-medium text-ink dark:text-dark-ink shrink-0 z-10">
                  {mod.number}
                </div>
                <div>
                  <h3 class="font-serif text-xl sm:text-2xl font-medium text-ink dark:text-dark-ink">
                    Unit 0{mod.number}: {mod.title}
                  </h3>
                  <p class="font-sans text-xs text-ink-muted dark:text-dark-muted mt-0.5">
                    {mod.description}
                  </p>
                </div>
              </div>

              <!-- Module Lessons List -->
              <div class="space-y-3 pl-3 sm:pl-4">
                {mod.lessons.map((lesson) => (
                  <article class="group relative rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50 dark:bg-dark-card hover:border-ink dark:hover:border-dark-ink transition-all p-4">
                    <a href={path(`/courses/${course.slug}/${lesson.slug}`)} class="block focus:outline-hidden">
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        
                        <!-- Title & Meta -->
                        <div>
                          <div class="flex items-center gap-2 mb-1.5">
                            <span class="font-mono text-xs font-medium text-ink-muted dark:text-dark-muted">
                              {lesson.lessonNumber}
                            </span>
                            <span class="font-mono text-xs text-ink-muted/80 dark:text-dark-muted/80">
                              · <span class={`font-medium ${getFormatColor(lesson.type)}`}>{lesson.type === 'video' ? 'Video' : lesson.type === 'pdf' ? 'PDF' : 'Article'}</span> · {lesson.readTime}
                            </span>
                          </div>

                          <h4 class="font-serif text-lg font-medium text-ink dark:text-dark-ink group-hover:underline transition-colors">
                            {lesson.title}
                          </h4>
                        </div>

                        <!-- Read Action -->
                        <div class="shrink-0 flex items-center gap-1.5 text-xs font-sans font-medium text-ink-muted dark:text-dark-muted group-hover:text-ink dark:group-hover:text-dark-ink pt-1 sm:pt-0">
                          <span>Study</span>
                          <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                          </svg>
                        </div>

                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </main>
</BaseLayout>
