---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ThemeSwitcher from '../../../components/ThemeSwitcher.astro';
import { COURSES } from '../../../data/courses';
import { path } from '../../../utils/paths';
import { getCategoryColor, getFormatColor } from '../../../utils/categoryColors';
import { countLessons } from '../../../utils/courseStats';

export function getStaticPaths() {
  return COURSES.map((course) => ({
    params: { course: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;

const STATUS_CONFIG: Record<string, { label: string; dotClass: string; textClass: string }> = {
  active: {
    label: 'Active',
    dotClass: 'bg-emerald-600 dark:bg-emerald-400',
    textClass: 'text-emerald-700 dark:text-emerald-400',
  },
  new: {
    label: 'New',
    dotClass: 'bg-blue-600 dark:bg-blue-400',
    textClass: 'text-blue-700 dark:text-blue-400',
  },
  explored: {
    label: 'Exploring',
    dotClass: 'bg-purple-600 dark:bg-purple-400',
    textClass: 'text-purple-700 dark:text-purple-400',
  },
  completed: {
    label: 'Completed',
    dotClass: 'bg-slate-500 dark:bg-slate-400',
    textClass: 'text-slate-600 dark:text-slate-400',
  },
};

const statusMeta = STATUS_CONFIG[course.status];
---

<BaseLayout title={`${course.title} — Learning Journey`} description={course.description}>
  <!-- Minimal Top Header for Course (Harmonized with HubHeader) -->
  <header 
    transition:name="hub-header"
    class="hub-header w-full border-b border-ink-border/60 dark:border-dark-border bg-paper-100/90 dark:bg-dark-bg/90 backdrop-blur-sm sticky top-0 z-30 transition-colors"
  >
    <div class="max-w-hub mx-auto px-6 h-16 flex items-center justify-between gap-4">
      <a href={path('/')} class="flex items-center gap-2 text-xs font-ui font-medium text-ink-muted dark:text-dark-muted hover:text-ink dark:hover:text-dark-ink transition-colors group">
        <svg class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span>Library of Curricula</span>
      </a>

      <div class="flex items-center gap-3">
        <span id="journey-progress-label" class="font-mono text-xs text-ink-muted dark:text-dark-muted">
          Progress: {course.progressPercent}%
        </span>
        <div class="w-20 h-[3px] bg-paper-300 dark:bg-dark-border rounded-none overflow-hidden">
          <div 
            id="journey-progress-fill"
            class="h-full bg-ink dark:bg-dark-ink transition-all duration-700 ease-out" 
            style={`width: ${course.progressPercent}%`}
          ></div>
        </div>
        <div class="h-4 w-px bg-ink-border/60 dark:bg-dark-border" aria-hidden="true"></div>
        <ThemeSwitcher />
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1" class="flex-1 max-w-reading w-full mx-auto px-6 py-12 focus:outline-none" data-course-id={course.id} data-total={countLessons(course)}>
    <!-- Course Title & Metadata (Library-Aligned Monograph) -->
    <div class="mb-14 pb-8 border-b border-ink-border/80 dark:border-dark-border">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class={`text-xs font-mono tracking-wider uppercase font-medium ${getCategoryColor(course.category)}`}>
          {course.category}
        </span>
        {statusMeta && (
          <span id="journey-status-badge" data-status={course.status} data-statusbadge class={`inline-flex items-center gap-1.5 text-[11px] font-mono tracking-wide ${statusMeta.textClass}`}>
            <span id="journey-status-dot" data-statusdot class={`w-1.5 h-1.5 rounded-full ${statusMeta.dotClass}`}></span>
            {statusMeta.label}
          </span>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-ink dark:text-dark-ink mb-4">
        {course.title}
      </h1>

      {course.description && (
        <p class="font-serif text-base sm:text-lg text-ink-muted dark:text-dark-muted max-w-3xl leading-relaxed">
          {course.description}
        </p>
      )}
    </div>

    <!-- The Architectural Learning Journey Grid -->
    <div class="max-w-3xl mx-auto">
      {course.modules.length === 0 ? (
        <div class="py-16 text-center border border-dashed border-ink-border dark:border-dark-border rounded-xs bg-paper-50/50 dark:bg-dark-card/50">
          <p class="font-serif text-lg text-ink dark:text-dark-ink">Curriculum is being structured</p>
          <p class="text-xs font-sans text-ink-muted dark:text-dark-muted mt-1">Check back as sources and modules are integrated into this track.</p>
        </div>
      ) : (
        <div>
          <!-- Quick Utilities: Single authoritative count & Global Expand/Collapse -->
          <div class="flex items-center justify-between pb-3.5 mb-6 border-b border-ink-border/60 dark:border-dark-border/60 text-xs font-mono text-ink-muted dark:text-dark-muted">
            <span>
              {course.modules.length} {course.modules.length === 1 ? 'Unit' : 'Units'} · {countLessons(course)} Lessons{course.duration ? ` · ${course.duration}` : ''}
            </span>
            <button 
              id="toggle-all-modules-btn" 
              class="hover:text-ink dark:hover:text-dark-ink transition-colors cursor-pointer flex items-center gap-1.5 focus:outline-hidden"
              data-action="collapse"
              title="Toggle all units"
            >
              <span id="toggle-all-text">Collapse all</span>
            </button>
          </div>

          <!-- Modules List -->
          <div class="space-y-6">
            {course.modules.map((mod) => (
              <section data-module-section={mod.id} class="border border-ink-border/80 dark:border-dark-border rounded-xs bg-white dark:bg-dark-card overflow-hidden transition-colors">
                <!-- Module Milestone Header (Interactive Accordion Trigger) -->
                <button
                  type="button"
                  class="module-toggle-btn w-full flex items-start justify-between gap-5 p-5 hover:bg-transparent transition-colors text-left group cursor-pointer focus:outline-hidden"
                  data-module-id={mod.id}
                  aria-expanded="true"
                >
                  <div class="flex items-start gap-4 min-w-0">
                    <!-- Concise Coordinate Badge: ONLY U1, U2 -->
                    <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-100 dark:bg-dark-surface text-ink-muted dark:text-dark-muted shrink-0 transition-colors shadow-2xs group-hover:text-ink dark:group-hover:text-dark-ink">
                      U{mod.number}
                    </span>

                    <div class="min-w-0 pt-[1px]">
                      <!-- Module Title - Clean and direct without redundant copy or underlines -->
                      <h2 class="font-serif text-lg sm:text-xl font-medium text-ink dark:text-dark-ink group-hover:text-ink-muted dark:group-hover:text-dark-muted transition-colors leading-snug">
                        {mod.title}
                      </h2>
                    </div>
                  </div>

                  <div class="flex items-center gap-3 shrink-0 pt-1 text-ink-muted dark:text-dark-muted group-hover:text-ink dark:group-hover:text-dark-ink transition-colors">
                    <span class="font-mono text-[11px]" data-module-stats={mod.id}>
                      {mod.lessons.length} {mod.lessons.length === 1 ? 'lesson' : 'lessons'}
                    </span>
                    <!-- Module progress bar -->
                    <div class="hidden sm:flex items-center gap-2 font-mono text-[11px]">
                      <div class="w-16 sm:w-20 h-[3px] bg-paper-300 dark:bg-dark-border rounded-none overflow-hidden">
                        <div 
                          class="h-full bg-paper-400 dark:bg-dark-border transition-all duration-500 ease-out"
                          data-module-fill={mod.id}
                          style="width: 0%"
                        ></div>
                      </div>
                      <span class="w-8 text-right font-medium text-ink-muted dark:text-dark-muted" data-module-pct={mod.id}>0%</span>
                    </div>
                    <svg 
                      class="w-4 h-4 transform transition-transform duration-200 chevron-icon rotate-180" 
                      viewBox="0 0 24 24" 
                      fill="none" 
                      stroke="currentColor" 
                      stroke-width="2" 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </div>
                </button>

                <!-- Lessons Tree-Grid (Collapsible Container with Smooth Grid Animation) -->
                <div 
                  id={`module-content-${mod.id}`} 
                  class="module-content grid transition-[grid-template-rows,opacity] duration-300 ease-in-out border-t border-ink-border/40 dark:border-dark-border/40"
                  style="grid-template-rows: 1fr; opacity: 1;"
                >
                  <div class="overflow-hidden min-h-0">
                    <div class="ml-4 sm:ml-5 pl-6 sm:pl-8 space-y-3 pt-3 pb-5 pr-4 sm:pr-5">
                      {mod.lessons.map((lesson, idx) => {
                        const isLast = idx === mod.lessons.length - 1;
                        return (
                          <div class="relative group">
                            {/* Architectural Tree-Grid Connectors */}
                            {!isLast ? (
                              <>
                                {/* Continuous vertical guide line */}
                                <div 
                                  class="absolute -left-6 sm:-left-8 -top-3 bottom-0 w-px bg-ink-border/80 dark:border-dark-border group-hover:bg-ink-muted/50 transition-colors" 
                                  aria-hidden="true"
                                />
                                {/* Horizontal orthogonal branch */}
                                <div 
                                  class="absolute -left-6 sm:-left-8 top-1/2 -translate-y-1/2 w-6 sm:w-8 h-px bg-ink-border/80 dark:bg-dark-border group-hover:bg-ink-muted/50 transition-colors" 
                                  aria-hidden="true"
                                />
                              </>
                            ) : (
                              <>
                                {/* Terminal corner bracket (└─) */}
                                <div 
                                  class="absolute -left-6 sm:-left-8 -top-3 h-[calc(50%+12px)] w-6 sm:w-8 border-l border-b border-ink-border/80 dark:border-dark-border rounded-bl-xs group-hover:border-ink-muted/50 transition-colors" 
                                  aria-hidden="true"
                                />
                              </>
                            )}

                            {/* Precision junction tick on the spine */}
                            <div 
                              class="absolute -left-6 sm:-left-8 -ml-[2px] top-1/2 -translate-y-1/2 w-1 h-1 rounded-full bg-paper-300 dark:bg-dark-border group-hover:bg-ink dark:group-hover:bg-dark-ink transition-colors z-10" 
                              aria-hidden="true"
                            />

                            <!-- Editorial Lesson Row Surface -->
                            <article data-lesson-slug={lesson.slug} class="relative overflow-hidden rounded-xs border border-ink-border/80 dark:border-dark-border bg-paper-50/70 dark:bg-dark-bg/60 hover:bg-white dark:hover:bg-dark-card hover:border-ink-border dark:hover:border-dark-border transition-colors duration-200 p-3 sm:p-3.5 shadow-2xs">
                              <a href={path(`/courses/${course.slug}/${lesson.slug}`)} class="block focus:outline-hidden">
                                <div class="flex items-center justify-between gap-4">
                                  
                                  <div class="flex items-start sm:items-center gap-3 sm:gap-4 min-w-0">
                                    <!-- Sequential Monospaced Coordinate Number: 01, 02 -->
                                    <span class="font-mono text-xs font-semibold text-ink-muted dark:text-dark-muted group-hover:text-ink dark:group-hover:text-dark-ink transition-colors shrink-0 pt-0.5 sm:pt-0">
                                      {String(idx + 1).padStart(2, '0')}
                                    </span>

                                    <div class="min-w-0">
                                      <h3 class="font-serif text-base sm:text-lg font-medium text-ink dark:text-dark-ink transition-colors truncate">
                                        {lesson.title}
                                      </h3>

                                      <div class="flex items-center gap-2 text-xs font-mono text-ink-muted/80 dark:text-dark-muted/80 mt-1">
                                        <span class={`font-medium ${getFormatColor(lesson.type)}`}>
                                          {lesson.type === 'video' ? 'Video' : lesson.type === 'pdf' ? 'PDF' : 'Article'}
                                        </span>
                                        <span>·</span>
                                        <span>{lesson.readTime}</span>
                                        {lesson.originalSourceLabel && (
                                          <>
                                            <span class="hidden sm:inline">·</span>
                                            <span class="hidden sm:inline truncate max-w-[220px] text-ink-muted/70 dark:text-dark-muted/70">
                                              {lesson.originalSourceLabel}
                                            </span>
                                          </>
                                        )}
                                      </div>
                                    </div>
                                  </div>

                                  <!-- Right Arrow & Read State Indicator -->
                                  <div class="shrink-0 flex items-center gap-2.5 text-ink-muted/60 dark:text-dark-muted/60 group-hover:text-ink dark:group-hover:text-dark-ink transition-colors">
                                    <span class="font-mono text-[10px] text-ink-muted dark:text-dark-muted" data-scroll-pct>0%</span>
                                    <span class="read-tick font-mono text-[11px] font-medium tracking-wide" data-read-tick>• New</span>
                                    <div class="w-6 h-6 flex items-center justify-center rounded-xs">
                                      <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M5 12h14M12 5l7 7-7 7"/>
                                      </svg>
                                    </div>
                                  </div>

                                </div>
                              </a>
                              <!-- Lesson Bottom Scroll Progress Bar -->
                              <div 
                                class="absolute bottom-0 left-0 h-[2.5px] transition-all duration-500 pointer-events-none"
                                data-lesson-progress-bar
                                style="width: 0%"
                              ></div>
                            </article>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </section>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Editorial Colophon Footer -->
    <footer class="mt-16 pt-8 border-t border-ink-border/60 dark:border-dark-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-sans text-ink-muted dark:text-dark-muted">
      <p>A sovereign, local-first reading sanctuary for rigorous study curricula.</p>
      <a href={path('/')} class="hover:text-ink dark:hover:text-dark-ink transition-colors underline underline-offset-4">
        &larr; Return to Library
      </a>
    </footer>
  </main>

  <!-- Client-side script for Collapsible Module Accordion -->
  <script is:inline>
    function initModuleAccordions() {
      const toggleAllBtn = document.getElementById('toggle-all-modules-btn');
      const toggleAllText = document.getElementById('toggle-all-text');
      const moduleToggles = document.querySelectorAll('.module-toggle-btn');
      
      const courseSlug = window.location.pathname.split('/').filter(Boolean).pop() || 'default';
      const storageKey = `ahkh_course_collapsed_${courseSlug}`;
      let collapsedModules = new Set();
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored) {
          collapsedModules = new Set(JSON.parse(stored));
        }
      } catch (e) {
        collapsedModules = new Set();
      }

      function setModuleState(moduleId, isCollapsed) {
        const content = document.getElementById(`module-content-${moduleId}`);
        const btn = document.querySelector(`.module-toggle-btn[data-module-id="${moduleId}"]`);
        const chevron = btn ? btn.querySelector('.chevron-icon') : null;

        if (isCollapsed) {
          if (content) {
            content.style.gridTemplateRows = '0fr';
            content.style.opacity = '0';
          }
          btn?.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('rotate-180');
          collapsedModules.add(moduleId);
        } else {
          if (content) {
            content.style.gridTemplateRows = '1fr';
            content.style.opacity = '1';
          }
          btn?.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
          collapsedModules.delete(moduleId);
        }
        try {
          localStorage.setItem(storageKey, JSON.stringify([...collapsedModules]));
        } catch (e) {}
        updateToggleAllButtonState();
      }

      function updateToggleAllButtonState() {
        if (!toggleAllBtn || !toggleAllText) return;
        const total = moduleToggles.length;
        if (total === 0) return;
        
        const allCollapsed = collapsedModules.size === total;
        if (allCollapsed) {
          toggleAllBtn.setAttribute('data-action', 'expand');
          toggleAllText.textContent = 'Expand all';
        } else {
          toggleAllBtn.setAttribute('data-action', 'collapse');
          toggleAllText.textContent = 'Collapse all';
        }
      }

      // Apply initial state
      moduleToggles.forEach((btn) => {
        const moduleId = btn.getAttribute('data-module-id');
        if (moduleId && collapsedModules.has(moduleId)) {
          setModuleState(moduleId, true);
        } else if (moduleId) {
          setModuleState(moduleId, false);
        }
      });

      // Handle individual accordion clicks
      moduleToggles.forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', () => {
          const moduleId = btn.getAttribute('data-module-id');
          if (!moduleId) return;
          const isCurrentlyCollapsed = collapsedModules.has(moduleId);
          setModuleState(moduleId, !isCurrentlyCollapsed);
        });
      });

      // Handle Toggle-All button
      if (toggleAllBtn && !toggleAllBtn.dataset.bound) {
        toggleAllBtn.dataset.bound = 'true';
        toggleAllBtn.addEventListener('click', () => {
          const currentAction = toggleAllBtn.getAttribute('data-action');
          const shouldCollapse = currentAction === 'collapse';
          moduleToggles.forEach((btn) => {
            const moduleId = btn.getAttribute('data-module-id');
            if (moduleId) {
              setModuleState(moduleId, shouldCollapse);
            }
          });
        });
      }
    }

    // Single boot path: ClientRouter (always enabled in BaseLayout) fires
    // astro:page-load on initial load and on every navigation.
    document.addEventListener('astro:page-load', initModuleAccordions);
    if (document.readyState === 'complete') {
      initModuleAccordions();
    }
  </script>

  <script is:inline>
    const STATUS_META = {
      active: { label: 'Active', dot: 'bg-emerald-600 dark:bg-emerald-400', text: 'text-emerald-700 dark:text-emerald-400' },
      new: { label: 'New', dot: 'bg-blue-600 dark:bg-blue-400', text: 'text-blue-700 dark:text-blue-400' },
      explored: { label: 'Exploring', dot: 'bg-purple-600 dark:bg-purple-400', text: 'text-purple-700 dark:text-purple-400' },
      completed: { label: 'Completed', dot: 'bg-slate-500 dark:bg-slate-400', text: 'text-slate-600 dark:text-slate-400' }
    };

    const LESSON_COLOR_CLASSES = {
      new: { text: 'text-blue-700 dark:text-blue-400', bar: 'bg-blue-600 dark:bg-blue-400' },
      explored: { text: 'text-purple-700 dark:text-purple-400', bar: 'bg-purple-600 dark:bg-purple-400' },
      reading: { text: 'text-amber-700 dark:text-amber-400', bar: 'bg-amber-600 dark:bg-amber-400' },
      completed: { text: 'text-emerald-700 dark:text-emerald-400', bar: 'bg-emerald-600 dark:bg-emerald-400' },
    };

    const ALL_LESSON_TEXT_CLASSES = [
      'text-blue-700', 'dark:text-blue-400',
      'text-purple-700', 'dark:text-purple-400',
      'text-amber-700', 'dark:text-amber-400',
      'text-emerald-700', 'dark:text-emerald-400',
      'text-slate-600', 'dark:text-slate-400'
    ];

    const ALL_BAR_CLASSES = [
      'bg-blue-600', 'dark:bg-blue-400',
      'bg-purple-600', 'dark:bg-purple-400',
      'bg-amber-600', 'dark:bg-amber-400',
      'bg-emerald-600', 'dark:bg-emerald-400',
      'bg-paper-400', 'dark:bg-dark-border'
    ];

    function refreshJourneyProgress() {
      try {
        if (typeof localStorage === 'undefined') return;
        const main = document.querySelector('main[data-course-id]');
        if (!main) return;
        const courseId = main.getAttribute('data-course-id');
        const totalAttr = main.getAttribute('data-total');
        const lessonEls = Array.from(document.querySelectorAll('[data-lesson-slug]'));
        const slugs = lessonEls.map((el) => el.getAttribute('data-lesson-slug')).filter(Boolean);
        const total = totalAttr ? parseInt(totalAttr, 10) : slugs.length;

        let totalCompleted = 0;
        let totalReading = 0;
        let totalExplored = 0;

        // 1. Process Individual Lessons
        lessonEls.forEach((el) => {
          try {
            const slug = el.getAttribute('data-lesson-slug');
            const tick = el.querySelector('[data-read-tick]');
            const scrollLabel = el.querySelector('[data-scroll-pct]');
            const progressBar = el.querySelector('[data-lesson-progress-bar]');
            if (!slug) return;

            const isCompleted = localStorage.getItem(`ahkh_read_${courseId}_${slug}`) !== null;
            const isReading = !isCompleted && localStorage.getItem(`ahkh_reading_${courseId}_${slug}`) !== null;
            const isExplored = !isCompleted && !isReading && localStorage.getItem(`ahkh_opened_${courseId}_${slug}`) !== null;

            let scrollPct = 0;
            try {
              const scrollData = JSON.parse(localStorage.getItem(`ahkh_scroll_${courseId}_${slug}`) || 'null');
              if (scrollData && typeof scrollData.percent === 'number') {
                scrollPct = Math.min(100, Math.max(0, scrollData.percent));
              }
            } catch (e) {}

            let state = 'new';
            let labelText = '• New';
            let barWidth = '0%';

            if (isCompleted) {
              state = 'completed';
              labelText = '• Completed';
              barWidth = '100%';
              scrollPct = 100;
              totalCompleted++;
            } else if (isReading) {
              state = 'reading';
              labelText = '• Reading';
              barWidth = `${scrollPct}%`;
              totalReading++;
            } else if (isExplored) {
              state = 'explored';
              labelText = '• Exploring';
              barWidth = `${scrollPct}%`;
              totalExplored++;
            }

            // Update tick
            if (tick) {
              tick.textContent = labelText;
              ALL_LESSON_TEXT_CLASSES.forEach((c) => tick.classList.remove(c));
              LESSON_COLOR_CLASSES[state].text.split(' ').forEach((c) => tick.classList.add(c));
            }

            // Update scroll label
            if (scrollLabel) {
              scrollLabel.textContent = `${scrollPct}%`;
            }

            // Update bottom progress line
            if (progressBar) {
              progressBar.style.width = barWidth;
              ALL_BAR_CLASSES.forEach((c) => progressBar.classList.remove(c));
              LESSON_COLOR_CLASSES[state].bar.split(' ').forEach((c) => progressBar.classList.add(c));
            }
          } catch (e) {}
        });

        // 2. Process Modules (Units)
        const moduleSections = Array.from(document.querySelectorAll('section[data-module-section]'));
        moduleSections.forEach((section) => {
          try {
            const modId = section.getAttribute('data-module-section');
            const modLessonEls = Array.from(section.querySelectorAll('[data-lesson-slug]'));
            const modTotal = modLessonEls.length;
            if (!modTotal) return;

            let modCompleted = 0;
            let modReading = 0;
            let modExplored = 0;

            modLessonEls.forEach((el) => {
              const slug = el.getAttribute('data-lesson-slug');
              if (localStorage.getItem(`ahkh_read_${courseId}_${slug}`) !== null) modCompleted++;
              else if (localStorage.getItem(`ahkh_reading_${courseId}_${slug}`) !== null) modReading++;
              else if (localStorage.getItem(`ahkh_opened_${courseId}_${slug}`) !== null) modExplored++;
            });

            const modPercent = Math.round((modCompleted / modTotal) * 100);
            const statsEl = section.querySelector(`[data-module-stats="${modId}"]`);
            const pctEl = section.querySelector(`[data-module-pct="${modId}"]`);
            const fillEl = section.querySelector(`[data-module-fill="${modId}"]`);

            if (statsEl) {
              statsEl.textContent = `${modCompleted}/${modTotal} completed`;
            }
            if (pctEl) {
              pctEl.textContent = `${modPercent}%`;
            }
            if (fillEl) {
              fillEl.style.width = `${modPercent}%`;
              ALL_BAR_CLASSES.forEach((c) => fillEl.classList.remove(c));
              if (modPercent === 100) {
                LESSON_COLOR_CLASSES.completed.bar.split(' ').forEach((c) => fillEl.classList.add(c));
              } else if (modReading > 0) {
                LESSON_COLOR_CLASSES.reading.bar.split(' ').forEach((c) => fillEl.classList.add(c));
              } else if (modExplored > 0) {
                LESSON_COLOR_CLASSES.explored.bar.split(' ').forEach((c) => fillEl.classList.add(c));
              } else {
                ['bg-paper-400', 'dark:bg-dark-border'].forEach((c) => fillEl.classList.add(c));
              }
            }
          } catch (e) {}
        });

        // 3. Process Overall Course Progress
        const percent = total ? Math.round((totalCompleted / total) * 100) : 0;
        const fill = document.getElementById('journey-progress-fill');
        if (fill) fill.style.width = percent + '%';
        const label = document.getElementById('journey-progress-label');
        if (label) label.textContent = `Progress: ${percent}%`;

        // 4. Update Course Status Badge
        const badge = document.getElementById('journey-status-badge');
        if (badge) {
          let chosenState = 'new';
          if (percent === 100) {
            chosenState = 'completed';
          } else if (totalCompleted > 0 || totalReading > 0) {
            chosenState = 'active';
          } else if (totalExplored > 0) {
            chosenState = 'explored';
          }

          const meta = STATUS_META[chosenState];
          if (meta) {
            const dot = badge.querySelector('[data-statusdot]');
            if (dot) dot.className = `w-1.5 h-1.5 rounded-full ${meta.dot}`;
            ['text-emerald-700', 'dark:text-emerald-400', 'text-blue-700', 'dark:text-blue-400', 'text-purple-700', 'dark:text-purple-400', 'text-slate-600', 'dark:text-slate-400'].forEach((c) => badge.classList.remove(c));
            meta.text.split(' ').forEach((c) => badge.classList.add(c));
            const textNode = Array.from(badge.childNodes).find((n) => n.nodeType === 3 && n.textContent.trim() !== '');
            if (textNode) textNode.textContent = ` ${meta.label}`;
            else badge.append(document.createTextNode(` ${meta.label}`));
          }
        }
      } catch (e) {}
    }

    if (!window.__ahkhJourneyBoot) {
      window.__ahkhJourneyBoot = true;
      document.addEventListener('astro:page-load', refreshJourneyProgress);
    }
    if (document.readyState === 'complete') {
      refreshJourneyProgress();
    }
  </script>
</BaseLayout>
